@model SV22T1080045.Shop.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="profile-page">
    <div class="container-custom">
        <div class="profile-layout">

            <!-- SIDEBAR: THÔNG TIN TỔNG QUAN & MENU -->
            <aside class="profile-sidebar">
                <div class="profile-card">
                    <div class="profile-user-head">
                        <div class="profile-avatar">
                            <div class="avatar-circle">
                                @((Model.CustomerName.FirstOrDefault() == default(char) ? 'K' : Model.CustomerName.First()).ToString().ToUpper())
                            </div>
                        </div>
                        <div class="profile-user-info">
                            <h2 class="profile-name">@Model.CustomerName</h2>
                            <p class="profile-phone">@Model.Phone</p>
                            <span class="member-badge">Thành viên thân thiết</span>
                        </div>
                    </div>

                    <div class="profile-stats">
                        <div class="stat-item">
                            <div class="stat-value">@Model.TotalOrders</div>
                            <div class="stat-label">Tổng đơn hàng</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.InTransitOrders</div>
                            <div class="stat-label">Đang giao</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.Points.ToString("N0")</div>
                            <div class="stat-label">Điểm tích lũy</div>
                        </div>
                    </div>

                    <nav class="profile-nav">
                        <a asp-controller="Account" asp-action="Profile" class="profile-nav-item active">
                            <i class="fa-regular fa-user"></i>
                            <span>Thông tin tài khoản</span>
                        </a>
                        <a asp-controller="MyOrders" asp-action="Index" class="profile-nav-item">
                            <i class="fa-solid fa-box-archive"></i>
                            <span>Lịch sử đơn hàng</span>
                        </a>
                        <a asp-controller="OrderLookup" asp-action="Index" class="profile-nav-item">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <span>Tra cứu đơn hàng</span>
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword" class="profile-nav-item">
                            <i class="fa-solid fa-key"></i>
                            <span>Đổi mật khẩu</span>
                        </a>
                        <div class="nav-divider"></div>
                        <a asp-controller="Account" asp-action="Logout" class="profile-nav-item logout">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </nav>
                </div>
            </aside>

            <!-- MAIN CONTENT: FORM CHỈNH SỬA THÔNG TIN -->
            <main class="profile-main">
                <div class="profile-paper">
                    <div class="profile-header">
                        <h1 class="profile-title">Thông tin cá nhân</h1>
                        <p class="profile-subtitle">Quản lý thông tin tài khoản và địa chỉ giao hàng mặc định.</p>
                    </div>

                    @if (TempData["ProfileSuccess"] != null)
                    {
                        <div class="alert-success">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>@TempData["ProfileSuccess"]</span>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Profile" method="post" class="profile-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="error-summary"></div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="CustomerName" class="form-label">Họ và tên <span class="required">*</span></label>
                                <input asp-for="CustomerName" class="form-input" placeholder="Nhập họ và tên..." />
                                <span asp-validation-for="CustomerName" class="form-error"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-input readonly-input" readonly tabindex="-1" />
                                <small class="form-hint">Số điện thoại dùng làm tài khoản đăng nhập (Không thể thay đổi)</small>
                            </div>

                            <div class="form-group full-width">
                                <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                                <input asp-for="Email" class="form-input" placeholder="example@gmail.com" />
                                <span asp-validation-for="Email" class="form-error"></span>
                            </div>

                            <div class="form-group full-width">
                                <label asp-for="Address" class="form-label">Địa chỉ giao hàng mặc định</label>
                                <textarea asp-for="Address" class="form-textarea" rows="3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                                <span asp-validation-for="Address" class="form-error"></span>
                            </div>
                        </div>

                        <div class="form-footer">
                            <a asp-controller="Home" asp-action="Index" class="btn-outline">Trở về trang chủ</a>
                            <button type="submit" class="btn-primary">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </main>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}