@model SV22T1080045.Shop.Models.ProfileViewModel
@{
    ViewData["Title"] = "Trang cá nhân";
}

<section class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="p-4 rounded-4 h-100" style="background:#fff; border:1px solid #ead8c9;">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:64px;height:64px;background:#2b211c;color:#fff;font-size:26px;font-weight:700;">
                        @((Model.CustomerName.FirstOrDefault() == default(char) ? 'K' : Model.CustomerName.First()).ToString().ToUpper())
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-1">@Model.CustomerName</h1>
                        <div class="text-secondary small">@Model.Phone</div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="OrderLookup" asp-action="Index" class="btn btn-outline-dark rounded-pill">
                        Tra cứu đơn hàng
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill">
                        Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="p-4 rounded-4" style="background:#fff; border:1px solid #ead8c9;">
                <h2 class="h4 fw-bold mb-3">Thông tin cá nhân</h2>
                <p class="text-secondary mb-4">
                    Địa chỉ cố định tại đây sẽ được ưu tiên điền sẵn khi thanh toán.
                </p>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success rounded-4">@TempData["ProfileSuccess"]</div>
                }

                <form asp-controller="Account" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label">Họ tên</label>
                            <input asp-for="CustomerName" class="form-control" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" readonly />
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Địa chỉ giao hàng cố định</label>
                            <textarea asp-for="Address" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill">Về trang chủ</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-4">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
