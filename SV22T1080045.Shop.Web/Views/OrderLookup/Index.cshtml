@{
    ViewData["Title"] = "Tra cứu đơn hàng";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="p-4 p-lg-5 rounded-4 shadow-sm" style="background:#fff; border:1px solid #ead8c9;">
                <h1 class="h3 fw-bold mb-3">Tra cứu đơn hàng bằng số điện thoại</h1>
                <p class="text-secondary">Luồng này bám theo spec guest checkout: nhập số điện thoại, nhận OTP 6 số, xác thực rồi xem danh sách đơn hàng.</p>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" id="phoneInput" class="form-control" placeholder="Ví dụ: 0909123456" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button id="sendOtpBtn" class="btn btn-dark w-100">Gửi mã OTP</button>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Mã OTP</label>
                        <input type="text" id="otpInput" class="form-control" maxlength="6" placeholder="Nhập 6 chữ số OTP" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button id="verifyOtpBtn" class="btn btn-outline-dark w-100">Xác thực</button>
                    </div>
                </div>

                <div id="lookupMessage" class="mt-3 small"></div>

                <div class="mt-4">
                    <h2 class="h5 fw-bold">Đơn hàng đã xác thực</h2>
                    <div id="ordersContainer" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const phoneInput = document.getElementById('phoneInput');
        const otpInput = document.getElementById('otpInput');
        const sendOtpBtn = document.getElementById('sendOtpBtn');
        const verifyOtpBtn = document.getElementById('verifyOtpBtn');
        const lookupMessage = document.getElementById('lookupMessage');
        const ordersContainer = document.getElementById('ordersContainer');

        function setMessage(text, isError) {
            lookupMessage.className = isError ? 'mt-3 small text-danger' : 'mt-3 small text-success';
            lookupMessage.textContent = text;
        }

        async function postJson(url, data) {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            return response.json();
        }

        async function loadOrders() {
            const response = await fetch('@Url.Action("OrdersJson", "OrderLookup")');
            const data = await response.json();

            if (data.error) {
                ordersContainer.innerHTML = '<div class="text-secondary">Chưa có dữ liệu đơn hàng sau xác thực.</div>';
                return;
            }

            if (!data.length) {
                ordersContainer.innerHTML = '<div class="text-secondary">Không tìm thấy đơn hàng nào cho số điện thoại này.</div>';
                return;
            }

            ordersContainer.innerHTML = data.map(order => `
                <div class="p-3 rounded-4 mb-3" style="background:#fbf7f2; border:1px solid #ead8c9;">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="fw-bold">Đơn #${order.orderId}</div>
                            <div class="small text-secondary">Ngày đặt: ${new Date(order.orderDate).toLocaleString('vi-VN')}</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-semibold text-danger">${Number(order.total).toLocaleString('vi-VN')}đ</div>
                            <div class="small text-secondary">Trạng thái: ${order.status}</div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        sendOtpBtn.addEventListener('click', async () => {
            const phone = phoneInput.value.trim();
            const result = await postJson('@Url.Action("SendOtp", "OrderLookup")', { phone });
            setMessage(result.message, !result.success);
        });

        verifyOtpBtn.addEventListener('click', async () => {
            const phone = phoneInput.value.trim();
            const code = otpInput.value.trim();
            const result = await postJson('@Url.Action("Verify", "OrderLookup")', { phone, code });
            setMessage(result.message ?? (result.success ? 'Xác thực thành công.' : 'Xác thực thất bại.'), !result.success);
            if (result.success) {
                await loadOrders();
            }
        });
    </script>
}
