@model SV22T1080045.Shop.Models.ViewModels.Checkout.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
    var input = Model.Input;
    var paymentMethod = input.PaymentMethod is 1 or 2 or 3 or 4 ? input.PaymentMethod : 1;
    var vnPayOk = ViewBag.VnPayConfigured as bool? == true;
    var moMoOk = ViewBag.MoMoConfigured as bool? == true;
    var vietQrOk = ViewBag.VietQrConfigured as bool? == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/commerce-flow.css" asp-append-version="true" />
}

<div class="commerce-flow">
    <div class="commerce-steps-wrap">
        <div class="commerce-steps">
            <div class="commerce-step done">
                <div class="commerce-step-circle"><i class="fa-solid fa-check"></i></div>
                <span class="commerce-step-label">Giỏ hàng</span>
            </div>
            <div class="commerce-step-line done"></div>
            <div class="commerce-step active">
                <div class="commerce-step-circle">2</div>
                <span class="commerce-step-label">Thông tin & thanh toán</span>
            </div>
            <div class="commerce-step-line"></div>
            <div class="commerce-step">
                <div class="commerce-step-circle">3</div>
                <span class="commerce-step-label">Hoàn tất</span>
            </div>
        </div>
    </div>

    <section class="commerce-page">
        <div class="commerce-layout">
            <form id="checkoutForm" asp-controller="Checkout" asp-action="PlaceOrder" method="post" class="commerce-panel checkout-form-panel">
                @Html.AntiForgeryToken()

                <div class="checkout-section">
                    <h1 class="checkout-section-title">
                        <span class="checkout-section-num">1</span>
                        Thông tin người nhận
                    </h1>
                    <div class="checkout-section-sub">Thông tin này dùng để giao hàng và liên hệ xác nhận đơn.</div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
                    }

                    <div class="form-grid">
                        <div>
                            <label asp-for="Input.ShippingName" class="form-label-soft">Họ và tên</label>
                            <input asp-for="Input.ShippingName" class="commerce-input" autocomplete="name" />
                            <span asp-validation-for="Input.ShippingName"></span>
                        </div>
                        <div>
                            <label asp-for="Input.ShippingPhone" class="form-label-soft">Số điện thoại</label>
                            <input asp-for="Input.ShippingPhone" class="commerce-input" placeholder="0901234567" autocomplete="tel" />
                            <span asp-validation-for="Input.ShippingPhone"></span>
                        </div>
                    </div>

                    <div class="form-grid single mt-3">
                        <div>
                            <label asp-for="Input.ShippingAddress" class="form-label-soft">Địa chỉ giao hàng</label>
                            <textarea asp-for="Input.ShippingAddress" class="commerce-textarea" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
                            <span asp-validation-for="Input.ShippingAddress"></span>
                        </div>
                    </div>

                    <div class="form-grid mt-3">
                        <div>
                            <label asp-for="Input.VoucherCode" class="form-label-soft">Mã giảm giá</label>
                            <div class="voucher-row">
                                <input asp-for="Input.VoucherCode" class="commerce-input" placeholder="Nhập mã voucher" autocomplete="off" />
                                <button id="applyVoucherBtn" type="button" class="commerce-btn primary square">Áp dụng</button>
                            </div>
                            <div id="checkoutVoucherOk" class="voucher-message ok"></div>
                            <div id="checkoutVoucherErr" class="voucher-message err"></div>
                        </div>
                        <div>
                            <label asp-for="Input.Note" class="form-label-soft">Ghi chú</label>
                            <input asp-for="Input.Note" class="commerce-input" placeholder="Ví dụ: gọi trước khi giao" />
                        </div>
                    </div>
                </div>

                <div class="checkout-section">
                    <h2 class="checkout-section-title">
                        <span class="checkout-section-num">2</span>
                        Phương thức thanh toán
                    </h2>
                    <div class="checkout-section-sub">Chọn cách thanh toán phù hợp với đơn hàng.</div>

                    <div class="payment-options">
                        <label class="payment-option @(paymentMethod == 1 ? "selected" : "")">
                            <input type="radio" name="Input.PaymentMethod" value="1" @(paymentMethod == 1 ? "checked" : "") />
                            <span class="payment-icon"><i class="fa-solid fa-truck-fast"></i></span>
                            <span>
                                <span class="payment-name">Thanh toán khi nhận hàng <span class="payment-pill">Phổ biến</span></span>
                                <span class="payment-desc d-block">Khách trả tiền khi nhận sản phẩm.</span>
                            </span>
                        </label>

                        <label class="payment-option @(paymentMethod == 2 ? "selected" : "") @(!vnPayOk ? "disabled" : "")">
                            <input type="radio" name="Input.PaymentMethod" value="2" @(paymentMethod == 2 ? "checked" : "") @(!vnPayOk ? "disabled" : "") />
                            <span class="payment-icon"><i class="fa-solid fa-credit-card"></i></span>
                            <span>
                                <span class="payment-name">VNPay</span>
                                <span class="payment-desc d-block">@(vnPayOk ? "Thanh toán qua cổng VNPay sandbox/production." : "Chưa cấu hình TmnCode/HashSecret.")</span>
                            </span>
                        </label>

                        <label class="payment-option @(paymentMethod == 3 ? "selected" : "") @(!moMoOk ? "disabled" : "")">
                            <input type="radio" name="Input.PaymentMethod" value="3" @(paymentMethod == 3 ? "checked" : "") @(!moMoOk ? "disabled" : "") />
                            <span class="payment-icon"><i class="fa-solid fa-mobile-screen-button"></i></span>
                            <span>
                                <span class="payment-name">MoMo</span>
                                <span class="payment-desc d-block">@(moMoOk ? "Thanh toán ví MoMo (redirect)." : "Chưa cấu hình PartnerCode/SecretKey.")</span>
                            </span>
                        </label>

                        <label class="payment-option @(paymentMethod == 4 ? "selected" : "") @(!vietQrOk ? "disabled" : "")">
                            <input type="radio" name="Input.PaymentMethod" value="4" @(paymentMethod == 4 ? "checked" : "") @(!vietQrOk ? "disabled" : "") />
                            <span class="payment-icon"><i class="fa-solid fa-qrcode"></i></span>
                            <span>
                                <span class="payment-name">Chuyển khoản QR (VietQR)</span>
                                <span class="payment-desc d-block">@(vietQrOk ? "Quét mã có sẵn số tiền và nội dung đơn." : "Chưa cấu hình tài khoản ngân hàng nhận.")</span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="Input.PaymentMethod"></span>
                </div>
            </form>

            <aside class="commerce-summary">
                <h2 class="commerce-summary-title">Đơn hàng của bạn</h2>

                <div class="order-items">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="order-item">
                            <div class="order-thumb">
                                @if (!string.IsNullOrWhiteSpace(item.Photo))
                                {
                                    <img class="order-item-img" src="@item.Photo" alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="order-item-img order-item-placeholder">
                                        <i class="fa-solid fa-leaf"></i>
                                    </div>
                                }
                                <span class="order-item-qty">@item.Quantity</span>
                            </div>
                            <div class="order-item-name">@item.ProductName</div>
                            <div class="order-item-price">@item.TotalPrice.ToString("N0")đ</div>
                        </div>
                    }
                </div>

                <div class="summary-rows">
                    <div class="summary-row">
                        <span class="lbl">Tạm tính</span>
                        <span class="val">@Model.TotalAmount.ToString("N0")đ</span>
                    </div>
                    <div id="checkoutDiscountRow" class="summary-row discount" style="display:@(Model.DiscountAmount > 0 ? "flex" : "none")">
                        <span id="checkoutDiscountLabel" class="lbl">Giảm giá@(Model.DiscountAmount > 0 && !string.IsNullOrWhiteSpace(input.VoucherCode) ? $" ({input.VoucherCode})" : "")</span>
                        <span id="checkoutDiscountVal" class="val">-@Model.DiscountAmount.ToString("N0")đ</span>
                    </div>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-total">
                    <span class="lbl">Tổng thanh toán</span>
                    <span id="checkoutFinalAmount" class="val">@Model.FinalAmount.ToString("N0")đ</span>
                </div>

                <label class="agree-box">
                    <input id="agreeCheck" type="checkbox" checked />
                    <span>Tôi xác nhận thông tin giao hàng và đồng ý đặt đơn theo chính sách của cửa hàng.</span>
                </label>

                <button type="submit" form="checkoutForm" class="commerce-btn primary block">
                    <i class="fa-solid fa-shield-halved"></i>
                    Đặt hàng ngay
                </button>
                <a asp-controller="Cart" asp-action="Index" class="commerce-btn secondary block mt-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại giỏ hàng
                </a>

                <div class="secure-note">
                    <i class="fa-solid fa-lock"></i>
                    Thông tin đơn hàng được xử lý qua backend hiện tại.
                </div>
            </aside>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (() => {
            const fmt = value => new Intl.NumberFormat('vi-VN').format(Math.max(0, value)) + 'đ';
            const subtotal = @Model.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const voucherInput = document.querySelector('[name="Input.VoucherCode"]');
            const applyBtn = document.getElementById('applyVoucherBtn');
            const ok = document.getElementById('checkoutVoucherOk');
            const err = document.getElementById('checkoutVoucherErr');
            const discountRow = document.getElementById('checkoutDiscountRow');
            const discountLabel = document.getElementById('checkoutDiscountLabel');
            const discountVal = document.getElementById('checkoutDiscountVal');
            const finalAmount = document.getElementById('checkoutFinalAmount');
            const agree = document.getElementById('agreeCheck');
            const checkoutForm = document.getElementById('checkoutForm');

            function setVoucherMessage(target, message) {
                ok.style.display = 'none';
                err.style.display = 'none';
                target.textContent = message;
                target.style.display = 'block';
            }

            async function applyVoucher() {
                const code = (voucherInput.value || '').trim().toUpperCase();
                voucherInput.value = code;
                discountRow.style.display = 'none';
                discountLabel.textContent = 'Giảm giá';
                discountVal.textContent = '-0đ';
                finalAmount.textContent = fmt(subtotal);

                if (!code) {
                    setVoucherMessage(err, 'Vui lòng nhập mã giảm giá.');
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('@Url.Action("ApplyVoucher", "Checkout")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ code, orderAmount: subtotal })
                });

                const data = await response.json();
                if (!data.success) {
                    setVoucherMessage(err, data.message || 'Mã giảm giá không hợp lệ.');
                    return;
                }

                const discount = Number(data.discount || 0);
                discountRow.style.display = 'flex';
                discountLabel.textContent = 'Giảm giá (' + code + ')';
                discountVal.textContent = '-' + fmt(discount);
                finalAmount.textContent = fmt(subtotal - discount);
                setVoucherMessage(ok, data.message || 'Mã giảm giá đã được áp dụng.');
            }

            applyBtn?.addEventListener('click', applyVoucher);
            voucherInput?.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyVoucher();
                }
            });

            document.querySelectorAll('.payment-option input[type="radio"]').forEach(input => {
                input.addEventListener('change', () => {
                    document.querySelectorAll('.payment-option').forEach(option => option.classList.remove('selected'));
                    input.closest('.payment-option')?.classList.add('selected');
                });
            });

            checkoutForm?.addEventListener('submit', event => {
                if (!agree?.checked) {
                    event.preventDefault();
                    alert('Vui lòng xác nhận thông tin trước khi đặt hàng.');
                }
            });

            if (voucherInput?.value && @((Model.DiscountAmount > 0).ToString().ToLowerInvariant())) {
                setVoucherMessage(ok, 'Mã giảm giá đã được áp dụng.');
            }
        })();
    </script>
}
