@model IEnumerable<SV22T1080045.Shop.DomainModels.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
}

<div class="box box-primary">
    <div class="box-body">
        <form action="~/Product" method="get">
            <div class="input-group">
                <input type="text" name="searchValue" class="form-control" placeholder="Nhập tên sản phẩm cần tìm...">
                <span class="input-group-btn">
                    <button type="submit" class="btn btn-info btn-flat">Tìm kiếm</button>
                    <a href="~/Product/Edit" class="btn btn-primary btn-flat" style="margin-left:5px">
                        <i class="fa fa-plus"></i> Bổ sung
                    </a>
                </span>
            </div>
        </form>

        <div class="table-responsive" style="margin-top:10px">
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr class="bg-primary">
                        <th>Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn vị tính</th>
                        <th>Mô tả</th>
                        <th>Thành phần</th>
                        <th>Thời gian cháy</th>
                        <th>Giá gốc</th>
                        <th>Giá sau khi giảm</th>
                        <th>Danh mục</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-danger">
                                Chưa có dữ liệu sản phẩm nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "images/no-image.jpg" : item.ImageUrl)"
                                         style="width:50px; height:50px; object-fit:cover" />
                                </td>
                                <td>@item.ProductName</td>
                                <td>@item.UnitId</td>
                                <td>@item.Description</td>
                                <td>@item.Ingredient</td>
                                <td>@item.BurningTime</td>
                                <td>@string.Format("{0:N}", item.OriginalPrice)</td>                              
                                <td>@string.Format("{0:N0}", item.PriceAfterDiscount)</td>
                                <td>@item.CategoryId</td>
                                <td class="text-right">
                                    <a href="~/Product/Edit/@item.Id" class="btn btn-xs btn-info">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a href="~/Product/Delete/@item.Id" class="btn btn-xs btn-danger">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>