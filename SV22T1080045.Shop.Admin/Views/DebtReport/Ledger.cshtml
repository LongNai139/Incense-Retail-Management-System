@{
    Layout = "_ManagementLayout";
}

@model List<SV22T1080045.Shop.DomainModels.Warehouse.CustomerDebtTransaction>
@using System.Globalization

@{
    ViewData["Title"] = "Sổ công nợ chi tiết";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    string TransactionTypeText(string type) => type switch
    {
        "DEBIT" => "Tăng nợ",
        "CREDIT" => "Giảm nợ",
        _ => type
    };
    string TransactionTypeClass(string type) => type switch
    {
        "DEBIT" => "text-danger",
        "CREDIT" => "text-success",
        _ => ""
    };
}

<div class="page-header">
    <h2 class="page-title">Sổ công nợ chi tiết</h2>
    @if (ViewBag.Customer != null)
    {
        <p class="customer-info">
            Khách hàng: <strong>@ViewBag.Customer.CustomerName</strong> (@ViewBag.Customer.Phone)
        </p>
    }
</div>

<div class="filter-bar mb-4">
    <form asp-action="Ledger" method="get" class="form-inline">
        <input type="hidden" name="customerId" value="@ViewBag.Customer?.CustomerId" />
        <div class="form-group mr-2">
            <label for="startDate">Từ ngày:</label>
            <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate">
        </div>
        <div class="form-group mr-2">
            <label for="endDate">Đến ngày:</label>
            <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate">
        </div>
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-action="Ledger" asp-route-customerId="@ViewBag.Customer?.CustomerId" class="btn btn-secondary">Đặt lại</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Ngày giao dịch</th>
                <th>Mã chứng từ</th>
                <th>Loại nghiệp vụ</th>
                <th>Nội dung</th>
                <th>Số tiền tăng</th>
                <th>Số tiền giảm</th>
                <th>Số dư sau</th>
                <th>Tham chiếu</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                var runningBalance = 0m;
                @foreach (var item in Model)
                {
                    var amount = item.TransactionType == "DEBIT" ? item.Amount : -item.Amount;
                    runningBalance += amount;

                    <tr>
                        <td>@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Reference</td>
                        <td>@TransactionTypeText(item.TransactionType)</td>
                        <td>@item.Description</td>
                        <td class="@TransactionTypeClass(item.TransactionType)">
                            @(item.TransactionType == "DEBIT" ? FormatMoney(item.Amount) : "-")
                        </td>
                        <td class="@TransactionTypeClass(item.TransactionType)">
                            @(item.TransactionType == "CREDIT" ? FormatMoney(item.Amount) : "-")
                        </td>
                        <td class="font-weight-bold">@FormatMoney(runningBalance)</td>
                        <td>
                            @if (item.OrderId.HasValue)
                            {
                                <a asp-controller="Management" asp-action="OrderDetails" asp-route-orderId="@item.OrderId.Value" target="_blank">
                                    Đơn #@item.OrderId.Value
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Summary" class="btn btn-secondary">Quay lại báo cáo tổng hợp</a>
</div>
