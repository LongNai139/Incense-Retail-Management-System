@{
    Layout = "_ManagementLayout";
}

@model List<SV22T1080045.Shop.Abstractions.Models.CustomerDebtAgingModel>
@using System.Globalization

@{
    ViewData["Title"] = "Báo cáo tuổi nợ";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
}

<div class="page-header">
    <h2 class="page-title">Báo cáo tuổi nợ</h2>
</div>

<div class="filter-bar mb-4">
    <form asp-action="Aging" method="get" class="form-inline">
        <div class="form-group mr-2">
            <label for="asOfDate">Tính đến ngày:</label>
            <input type="date" id="asOfDate" name="asOfDate" class="form-control" value="@ViewBag.AsOfDate">
        </div>
        <div class="form-group mr-2">
            <label for="customerId">Khách hàng:</label>
            <select id="customerId" name="customerId" class="form-control">
                <option value="">Tất cả</option>
                @if (ViewBag.Customers != null)
                {
                    @foreach (var customer in ViewBag.Customers)
                    {
                        <option value="@customer.CustomerId" selected="@(ViewBag.SelectedCustomerId == customer.CustomerId)">
                            @customer.CustomerName - @customer.Phone
                        </option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-action="Aging" class="btn btn-secondary">Đặt lại</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Tên khách hàng</th>
                <th>Số điện thoại</th>
                <th>Tổng nợ hiện tại</th>
                <th>Chưa đến hạn</th>
                <th>Quá hạn 1-30 ngày</th>
                <th>Quá hạn 31-60 ngày</th>
                <th>Quá hạn >60 ngày</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerId</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerPhone</td>
                        <td class="font-weight-bold">@FormatMoney(item.CurrentBalance)</td>
                        <td class="text-success">@FormatMoney(item.NotDue)</td>
                        <td class="text-warning">@FormatMoney(item.Overdue1To30)</td>
                        <td class="text-danger">@FormatMoney(item.Overdue31To60)</td>
                        <td class="text-danger font-weight-bold">@FormatMoney(item.OverdueOver60)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Quay lại tổng quan</a>
</div>
