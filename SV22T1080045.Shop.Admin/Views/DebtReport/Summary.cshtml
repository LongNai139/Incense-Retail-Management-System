@{
    Layout = "_ManagementLayout";
}

@model List<SV22T1080045.Shop.Abstractions.Models.CustomerDebtSummaryModel>
@using System.Globalization

@{
    ViewData["Title"] = "Báo cáo tổng hợp công nợ";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    string StatusText(string status) => status switch
    {
        "Pending" => "Chưa thanh toán",
        "PartiallyPaid" => "Thanh toán một phần",
        "Paid" => "Đã thanh toán",
        "Overdue" => "Quá hạn",
        _ => status
    };
    string StatusClass(string status) => status switch
    {
        "Pending" => "status-pending",
        "PartiallyPaid" => "status-ready",
        "Paid" => "status-done",
        "Overdue" => "status-cancel",
        _ => "status-ready"
    };
}

<div class="page-header">
    <h2 class="page-title">Báo cáo tổng hợp công nợ</h2>
</div>

<div class="filter-bar mb-4">
    <form asp-action="Summary" method="get" class="form-inline">
        <div class="form-group mr-2">
            <label for="startDate">Từ ngày:</label>
            <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate">
        </div>
        <div class="form-group mr-2">
            <label for="endDate">Đến ngày:</label>
            <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate">
        </div>
        <div class="form-group mr-2">
            <label for="customerId">Khách hàng:</label>
            <select id="customerId" name="customerId" class="form-control">
                <option value="">Tất cả</option>
                @if (ViewBag.Customers != null)
                {
                    @foreach (var customer in ViewBag.Customers)
                    {
                        <option value="@customer.CustomerId" selected="@(ViewBag.SelectedCustomerId == customer.CustomerId)">
                            @customer.CustomerName - @customer.Phone
                        </option>
                    }
                }
            </select>
        </div>
        <div class="form-group mr-2">
            <label for="status">Trạng thái:</label>
            <select id="status" name="status" class="form-control">
                <option value="">Tất cả</option>
                <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Chưa thanh toán</option>
                <option value="PartiallyPaid" selected="@(ViewBag.SelectedStatus == "PartiallyPaid")">Thanh toán một phần</option>
                <option value="Paid" selected="@(ViewBag.SelectedStatus == "Paid")">Đã thanh toán</option>
                <option value="Overdue" selected="@(ViewBag.SelectedStatus == "Overdue")">Quá hạn</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-action="Summary" class="btn btn-secondary">Đặt lại</a>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Tên khách hàng</th>
                <th>Số điện thoại</th>
                <th>Dư nợ đầu kỳ</th>
                <th>Phát sinh tăng</th>
                <th>Phát sinh giảm</th>
                <th>Đã thanh toán</th>
                <th>Dư nợ cuối kỳ</th>
                <th>Nợ quá hạn</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerId</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerPhone</td>
                        <td>@FormatMoney(item.OpeningBalance)</td>
                        <td class="text-danger">@FormatMoney(item.DebitAmount)</td>
                        <td class="text-success">@FormatMoney(item.CreditAmount)</td>
                        <td class="text-success">@FormatMoney(item.PaidAmount)</td>
                        <td class="font-weight-bold">@FormatMoney(item.ClosingBalance)</td>
                        <td class="text-danger">@FormatMoney(item.OverdueAmount)</td>
                        <td><span class="@StatusClass(item.Status)">@StatusText(item.Status)</span></td>
                        <td>
                            <a asp-action="Ledger" asp-route-customerId="@item.CustomerId" class="btn btn-sm btn-info">Xem sổ</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Quay lại tổng quan</a>
</div>
