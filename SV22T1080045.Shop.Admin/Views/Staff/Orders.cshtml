@model SV22T1080045.Shop.Models.ViewModels.Staff.StaffOrderViewModel
@using System.Globalization
@using SV22T1080045.Shop.Controllers
@using SV22T1080045.Shop.Models
@{
    ViewData["Title"] = "Đơn hàng";
    Layout = "_StaffLayout";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    string Money(decimal value) => value.ToString("N0", vi) + "đ";
    string DateTimeText(DateTime value) => value.ToString("dd/MM HH:mm", vi);
}

@if (TempData["StaffMessage"] is string message)
{
    <div class="staff-toast">@message</div>
}

<section class="staff-section">
    <div class="staff-section-head">
        <div>
            <span class="staff-kicker">Chức năng chính</span>
            <h2>Quản lý đơn hàng</h2>
        </div>
        <div class="staff-note">Hiển thị đơn ngày @Model.WorkDate.ToString("dd/MM/yyyy", vi) và đơn còn công nợ. Staff không thể xóa đơn hoặc chỉnh sửa tiền đơn hàng.</div>
    </div>

    <form class="staff-filter" asp-controller="Staff" asp-action="Orders" method="get">
        <input type="search" name="orderSearchValue" value="@Model.OrderSearchValue" placeholder="Tìm mã đơn, khách, số điện thoại" />
        <select name="orderStatus">
            <option value="">Tất cả trạng thái</option>
            <option value="1" selected="@(Model.OrderStatus == 1 ? "selected" : null)">Chờ xử lý</option>
            <option value="2" selected="@(Model.OrderStatus == 2 ? "selected" : null)">Đang chuẩn bị</option>
            <option value="3" selected="@(Model.OrderStatus == 3 ? "selected" : null)">Đang giao</option>
            <option value="4" selected="@(Model.OrderStatus == 4 ? "selected" : null)">Hoàn thành</option>
            <option value="-1" selected="@(Model.OrderStatus == -1 ? "selected" : null)">Giao thất bại</option>
        </select>
        <button class="staff-btn primary" type="submit"><i class="fa-solid fa-filter"></i> Lọc</button>
        <a class="staff-btn" asp-controller="Staff" asp-action="Orders"><i class="fa-solid fa-xmark"></i> Xóa lọc</a>
    </form>

    <div class="staff-order-list">
        @if (Model.Orders.Any())
        {
            foreach (var order in Model.Orders)
            {
                var paymentReference = $"STAFF-{Guid.NewGuid():N}";
                <article class="staff-order-card @(order.Status == 1 && order.OrderDate <= DateTime.Now.AddHours(-2) ? "urgent" : null)" id="order-@order.Id" data-order-code="@order.OrderCode">
                    <div class="staff-order-main">
                        <div>
                            <div class="staff-order-code">@order.OrderCode</div>
                            <div class="staff-order-meta">@order.CustomerName · @order.CustomerPhone · @DateTimeText(order.OrderDate)</div>
                        </div>
                        <div class="staff-order-money">@Money(order.FinalAmount)</div>
                        <span class="staff-status @StaffController.StatusClass(order.Status)">@StaffController.StatusText(order.Status)</span>
                        <span class="staff-status staff-status-neutral">@order.PaymentStatusText</span>
                    </div>

                    <div class="staff-order-actions">
                        <form asp-controller="Staff" asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <select name="status">
                                <option value="1" selected="@(order.Status == 1 ? "selected" : null)">Chờ xử lý</option>
                                <option value="2" selected="@(order.Status == 2 ? "selected" : null)">Đang chuẩn bị</option>
                                <option value="3" selected="@(order.Status == 3 ? "selected" : null)">Đang giao</option>
                                <option value="4" selected="@(order.Status == 4 ? "selected" : null)">Hoàn thành</option>
                            </select>
                            <button class="staff-btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Cập nhật</button>
                        </form>
                        <button class="staff-btn" type="button" data-print-target="invoice-@order.Id"><i class="fa-solid fa-print"></i> In hóa đơn</button>
                        <button class="staff-btn" type="button" data-print-target="delivery-@order.Id"><i class="fa-solid fa-file-export"></i> Phiếu giao</button>
                    </div>

                    <details class="staff-order-detail">
                        <summary>Chi tiết đơn hàng</summary>
                        <div class="staff-detail-grid">
                            <div>
                                <strong>Thông tin khách</strong>
                                <span>@order.CustomerName</span>
                                <span>@order.CustomerPhone</span>
                                <span>@order.ShippingAddress</span>
                            </div>
                            <div>
                                <strong>Lịch sử trạng thái</strong>
                                <span>Hiện tại: @StaffController.StatusText(order.Status)</span>
                                <strong>Thanh toán</strong>
                                <span>Phương thức: @OrderStatusLabels.GetPaymentMethodText(order.PaymentMethod)</span>
                                <span>Phải thu: @Money(order.FinalAmount)</span>
                                <span>Đã thu/xác minh: @Money(order.PaidAmount)</span>
                                <span>@(order.CustomerDebtId.HasValue ? "Còn nợ" : "Còn phải thanh toán"): @Money(order.RemainingAmount)</span>
                                @if (!string.IsNullOrWhiteSpace(order.PaymentTransactionNo))
                                {
                                    <span>Mã giao dịch: @order.PaymentTransactionNo</span>
                                }
                                @if (order.PaidAt.HasValue)
                                {
                                    <span>Ghi nhận lúc: @order.PaidAt.Value.ToString("dd/MM/yyyy HH:mm", vi)</span>
                                }
                                @if (order.PaymentMethod == 1 && order.Status == 4 && !order.CustomerDebtId.HasValue)
                                {
                                    <span>Chưa có khoản phải thu gắn với đơn này.</span>
                                }
                            </div>
                        </div>
                        @if (Model.CanCollectPayment && order.CustomerDebtId.HasValue && order.RemainingAmount > 0)
                        {
                            <form asp-controller="Staff" asp-action="RecordOrderPayment" method="post" class="staff-payment-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="paymentReference" value="@paymentReference" />
                                <label>Số tiền thực thu
                                    <input name="paymentAmount" type="number" min="0.01" max="@order.RemainingAmount" step="0.01" required />
                                </label>
                                <button class="staff-btn primary" type="submit"><i class="fa-solid fa-money-bill-transfer"></i> Ghi nhận khoản thu</button>
                            </form>
                        }
                        @if (Model.CanVerifyQrPayment && order.PaymentMethod == 4 && order.PaymentStatus == 4)
                        {
                            <form asp-controller="Staff" asp-action="VerifyQrPayment" method="post" class="staff-payment-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <label>Mã tham chiếu giao dịch đã đối chiếu
                                    <input name="paymentReference" maxlength="100" required />
                                </label>
                                <button class="staff-btn primary" type="submit">Xác nhận đã nhận đủ tiền</button>
                            </form>
                        }
                        @if (order.PaymentHistory.Count > 0)
                        {
                            <div class="staff-payment-history">
                                <strong>Lịch sử công nợ và thu tiền</strong>
                                <ul>
                                    @foreach (var entry in order.PaymentHistory)
                                    {
                                        <li>
                                            @entry.TransactionDate.ToString("dd/MM/yyyy HH:mm", vi) ·
                                            @(entry.TransactionType == "DEBIT" ? "Phát sinh nợ" : "Đã thu")
                                            @Money(entry.Amount) · còn @Money(entry.BalanceAfter)
                                            @if (!string.IsNullOrWhiteSpace(entry.Reference))
                                            {
                                                <span>(@entry.Reference)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <table class="staff-table compact">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>SL</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@Money(item.UnitPrice)</td>
                                        <td>@Money(item.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>

                    <div class="staff-print" id="invoice-@order.Id">
                        <h2>Hóa đơn @order.OrderCode</h2>
                        <p>@order.CustomerName - @order.CustomerPhone</p>
                        <p>@order.ShippingAddress</p>
                        <table>
                            @foreach (var item in order.Items)
                            {
                                <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@Money(item.LineTotal)</td></tr>
                            }
                        </table>
                        <strong>Tổng: @Money(order.FinalAmount)</strong>
                    </div>
                    <div class="staff-print" id="delivery-@order.Id">
                        <h2>Phiếu giao hàng @order.OrderCode</h2>
                        <p>Người nhận: @order.CustomerName</p>
                        <p>SĐT: @order.CustomerPhone</p>
                        <p>Địa chỉ: @order.ShippingAddress</p>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="staff-empty">Không tìm thấy đơn hàng phù hợp.</div>
        }
    </div>
</section>
