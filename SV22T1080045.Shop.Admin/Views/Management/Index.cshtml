@{
    Layout = "_ManagementLayout";
}

@model SV22T1080045.Shop.Models.ViewModels.Management.ManagementDashboardViewModel
@using System.Globalization
@using SV22T1080045.Shop.Models.ViewModels.Management

@{
    ViewData["Title"] = "Tổng quan";

    var allProducts = Model.AllProducts ?? new List<ManagementProductRowViewModel>();
    var bestSellers = allProducts.OrderByDescending(p => p.SoldCount ?? 0).Take(5).ToList();
    var lowStockProducts = allProducts.Where(p => (p.Quantity ?? 0) > 0 && (p.Quantity ?? 0) <= 5).OrderBy(p => p.Quantity ?? 0).Take(5).ToList();
    var outOfStockCount = allProducts.Count(p => (p.Quantity ?? 0) <= 0);
    var revenueSummary = Model.RevenueSummary;
    var bestRevenuePoint = Model.RevenuePoints.OrderByDescending(p => p.Revenue).FirstOrDefault();
    var reportDateValue = Model.RevenueDate.ToString("yyyy-MM-dd");
    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    string FormatRange(DateTime start, DateTime end) => start.Date == end.AddDays(-1).Date
        ? start.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
        : $"{start.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))} - {end.AddDays(-1).ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))}";
    string FormatPercent(decimal value) => (value >= 0 ? "+" : "") + value.ToString("N1", CultureInfo.GetCultureInfo("vi-VN")) + "%";
    string MaskPhone(string? phone) => string.IsNullOrWhiteSpace(phone) || phone.Length < 4 ? "***" : "***" + phone[^4..];
    string StatusText(int status) => status switch { 1 => "Chờ xử lý", 2 => "Đang chuẩn bị", 3 => "Đang giao", 4 => "Hoàn thành", -1 => "Đã hủy", _ => "Khác" };
    string StatusClass(int status) => status switch { 1 => "status-pending", 2 => "status-ready", 3 => "status-shipped", 4 => "status-done", -1 => "status-cancel", _ => "status-ready" };
}

<section class="management-hero">
    <div>
        <div class="management-kicker">Precious Wood</div>
        <h1>Trang tổng quan</h1>
        <p>Theo dõi doanh thu, xử lý đơn, chăm tồn kho và khách hàng trên cùng một khu vực quản trị.</p>
    </div>
    <div class="management-actions">
        <button class="admin-btn" type="button" data-sound-toggle>
            <i class="fa-solid fa-volume-high"></i> Âm báo
        </button>
        <select class="admin-select" data-sound-style style="min-width: 170px;">
            <option value="classic">Âm: Classic</option>
            <option value="soft">Âm: Soft</option>
            <option value="sharp">Âm: Sharp</option>
        </select>
        <input class="admin-input" data-sound-volume type="range" min="0" max="100" step="1" value="35" style="width: 160px;" />
        <a class="admin-btn primary" asp-controller="Management" asp-action="Products"><i class="fa-solid fa-plus"></i> Thêm sản phẩm</a>
        <button class="admin-btn"><i class="fa-solid fa-file-import"></i> Import Excel</button>
        <a class="admin-btn success" asp-controller="Management" asp-action="ExportRevenueReport" asp-route-reportPeriod="@Model.RevenuePeriod" asp-route-reportDate="@reportDateValue"><i class="fa-solid fa-file-export"></i> Xuất báo cáo</a>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div class="admin-section-heading-block">
            <h2>Trang tổng quan</h2>
            <p class="admin-section-desc">Doanh thu theo ngày, tuần, tháng hoặc một ngày cụ thể. Khoảng đang xem: @FormatRange(Model.RevenueRangeStart, Model.RevenueRangeEnd).</p>
            <form class="time-filter-row" asp-controller="Management" asp-action="Index" method="get">
                <select class="admin-select" name="revenuePeriod">
                    <option value="day" selected="@(Model.RevenuePeriod == "day" ? "selected" : null)">Theo ngày</option>
                    <option value="week" selected="@(Model.RevenuePeriod == "week" ? "selected" : null)">Theo tuần</option>
                    <option value="month" selected="@(Model.RevenuePeriod == "month" ? "selected" : null)">Theo tháng</option>
                </select>
                <input class="admin-input" type="date" name="revenueDate" value="@Model.RevenueDate.ToString("yyyy-MM-dd")" />
                <button class="admin-btn" type="submit"><i class="fa-solid fa-filter"></i> Xem doanh thu</button>
            </form>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon revenue"><i class="fa-solid fa-coins"></i></div>
            <div class="kpi-label">Doanh thu tổng cộng</div>
            <div class="kpi-value">@FormatMoney(revenueSummary.TotalRevenue)</div>
            <div class="kpi-note">Tổng doanh thu tất cả thời gian</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon revenue"><i class="fa-solid fa-chart-line"></i></div>
            <div class="kpi-label">Doanh thu kỳ này</div>
            <div class="kpi-value">@FormatMoney(revenueSummary.Revenue)</div>
            <div class="kpi-note">@FormatPercent(revenueSummary.RevenueChangePercent) so với kỳ trước</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon orders"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-label">Tổng đơn hàng</div>
            <div class="kpi-value">@revenueSummary.OrderCount</div>
            <div class="kpi-note">@revenueSummary.CompletedOrderCount đơn hoàn thành</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon customers"><i class="fa-solid fa-user-plus"></i></div>
            <div class="kpi-label">Khách hàng mới</div>
            <div class="kpi-value">@revenueSummary.NewCustomerCount</div>
            <div class="kpi-note">@revenueSummary.GuestOrderCount đơn khách vãng lai</div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="admin-panel">
            <div class="panel-title">
                <span>Tổng quan chi tiết</span>
                <span class="status-badge status-ready">Dữ liệu gần đây</span>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders.Any())
                        {
                            foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>@order.OrderCode</td>
                                    <td>@(order.IsGuest ? $"Guest {MaskPhone(order.CustomerPhone)}" : order.CustomerName)</td>
                                    <td>@order.ProductTypeCount món</td>
                                    <td>@order.ItemCount</td>
                                    <td>@FormatMoney(order.TotalAmount)</td>
                                    <td><span class="status-badge @StatusClass(order.Status)">@StatusText(order.Status)</span></td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7">Chưa có đơn hàng trong database.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-panel">
            <div class="panel-title">Alerts</div>
            <div class="alert-box-red">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong>Cảnh báo hệ thống</strong>
                    <span>Có @lowStockProducts.Count sản phẩm sắp hết hàng cần xử lý</span>
                </div>
            </div>
            <div class="alerts-list">
                @if (lowStockProducts.Any())
                {
                    foreach (var item in lowStockProducts.Take(3))
                    {
                        <div class="alert-item warning">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div>
                                <strong>Lỗi kho</strong>
                                <span>@item.ProductName còn @(item.Quantity ?? 0) chiếc</span>
                            </div>
                        </div>
                    }
                }
                @if (Model.RecentOrders.Any(o => o.Status == 1))
                {
                    var pendingOrder = Model.RecentOrders.FirstOrDefault(o => o.Status == 1);
                    if (pendingOrder != null)
                    {
                        <div class="alert-item warning">
                            <i class="fa-solid fa-clock"></i>
                            <div>
                                <strong>Đơn hàng @pendingOrder.OrderCode chờ xác nhận</strong>
                                <span>Khách hàng @(pendingOrder.IsGuest ? "vãng lai" : pendingOrder.CustomerName)</span>
                            </div>
                        </div>
                    }
                }
                @if (!lowStockProducts.Any() && !Model.RecentOrders.Any(o => o.Status == 1))
                {
                    <div class="item-meta">Không có cảnh báo nào.</div>
                }
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="admin-panel">
            <div class="panel-title">
                <span>Biểu đồ doanh thu</span>
                <span class="status-badge status-ready">@FormatRange(Model.RevenueRangeStart, Model.RevenueRangeEnd)</span>
            </div>
            <div class="chart-container" style="padding: 16px;">
                <canvas id="revenueBarChart" height="220"></canvas>
            </div>
            <div class="chart-guide" style="margin-top: 16px;">
                <strong>Kết luận nhanh:</strong>
                @if (bestRevenuePoint != null && bestRevenuePoint.Revenue > 0)
                {
                    <span>@bestRevenuePoint.Label bán tốt nhất với @FormatMoney(bestRevenuePoint.Revenue) từ @bestRevenuePoint.OrderCount đơn.</span>
                }
                else
                {
                    <span>Khoảng này chưa có doanh thu.</span>
                }
            </div>
        </div>

        <div class="admin-panel">
            <div class="panel-title">Tỷ lệ danh mục sản phẩm</div>
            <div class="donut-chart-container">
                <div class="donut-chart">
                    @{
                        var categoryData = bestSellers.GroupBy(p => p.CategoryId).Select(g => new {
                            CategoryId = g.Key,
                            CategoryName = Model.Categories.FirstOrDefault(c => c.Id == g.Key)?.CategoryName ?? $"Danh mục {g.Key}",
                            Count = g.Sum(x => x.SoldCount ?? 0),
                            Revenue = g.Sum(x => (x.SoldCount ?? 0) * x.PriceAfterDiscount)
                        }).ToList();
                        var totalQuantity = categoryData.Sum(c => c.Count);
                        var totalRevenue = categoryData.Sum(c => c.Revenue);
                        var colors = new[] { "#c9a961", "#8a6d28", "#d4b86a", "#a67c3d", "#b98b36", "#52745b" };
                        var colorIndex = 0;
                    }
                    @if (categoryData.Any())
                    {
                        var conicGradient = "";
                        var currentPercentage = 0.0m;

                        foreach (var category in categoryData.OrderByDescending(c => c.Revenue))
                        {
                            var percentage = totalRevenue > 0 ? (category.Revenue / totalRevenue) * 100 : 0;
                            var color = colors[colorIndex % colors.Length];
                            var nextPercentage = currentPercentage + percentage;

                            conicGradient += $"{color} {currentPercentage}% {nextPercentage}%, ";
                            currentPercentage = nextPercentage;
                            colorIndex++;
                        }

                        conicGradient = conicGradient.TrimEnd(',', ' ');

                        <div class="donut-segment" style="background: conic-gradient(@conicGradient);"></div>
                        <div class="donut-hole"></div>
                        <div class="donut-text">@FormatMoney(totalRevenue)</div>
                    }
                    else
                    {
                        <div class="donut-empty">Chưa có dữ liệu</div>
                    }
                </div>
                <div class="donut-legend">
                    @if (categoryData.Any())
                    {
                        colorIndex = 0;
                        foreach (var category in categoryData.OrderByDescending(c => c.Revenue).Take(5))
                        {
                            var percentage = totalRevenue > 0 ? (category.Revenue / totalRevenue) * 100 : 0;
                            var color = colors[colorIndex % colors.Length];

                            <div class="legend-item">
                                <div class="legend-color" style="background: @color;"></div>
                                <div class="legend-text">@category.CategoryName</div>
                                <div class="legend-value">@percentage.ToString("0.1")%</div>
                            </div>

                            colorIndex++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="admin-panel">
            <div class="panel-title">Low Stock Items</div>
            <div class="warning-list">
                @if (lowStockProducts.Any())
                {
                    foreach (var item in lowStockProducts)
                    {
                        <div class="warning-item">
                            <div>
                                <div class="item-name">@item.ProductName</div>
                                <div class="item-meta">@item.Origin</div>
                            </div>
                            <div class="warning-count">@(item.Quantity ?? 0)</div>
                        </div>
                    }
                }
                else
                {
                    <div class="item-meta">Không có sản phẩm nào dưới 5 tồn kho.</div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenuePoints.OrderBy(p => p.Label).Select(p => p.Label)));
            const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenuePoints.OrderBy(p => p.Label).Select(p => p.Revenue)));
            const canvas = document.getElementById('revenueBarChart');
            if (!canvas || typeof Chart === 'undefined') {
                console.error('Chart.js chưa được tải');
                return;
            }
            new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: values,
                        backgroundColor: 'rgba(201, 169, 97, 0.8)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: '#e8d9b5' }, grid: { color: 'rgba(255,255,255,.06)' } },
                        y: { beginAtZero: true, ticks: { color: '#e8d9b5' }, grid: { color: 'rgba(255,255,255,.06)' } }
                    }
                }
            });
        })();
    </script>
    <script>
        document.querySelectorAll('.management-nav a').forEach(function (link) {
            link.addEventListener('click', function () {
                document.querySelectorAll('.management-nav a').forEach(function (item) {
                    item.classList.remove('active');
                });
                link.classList.add('active');
            });
        });
    </script>
    <script>
        window.operationalAlertsConfig = {
            feedUrl: '@Url.Action("Feed", "OperationalAlerts")',
            storageKey: 'managementOperationalAlerts',
            pollIntervalMs: 30000
        };
    </script>
    <script src="~/js/operational-alerts.js" asp-append-version="true"></script>
}