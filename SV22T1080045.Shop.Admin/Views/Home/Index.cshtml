@model IEnumerable<SV22T1080045.Shop.DomainModels.Product>
@using SV22T1080045.Shop.DomainModels
@{
    ViewData["Title"] = "Trang chủ";
    var featuredProducts = ViewBag.FeaturedProducts as List<Product> ?? new();
    var categories = ViewBag.Categories as List<Category> ?? new();
    var allProducts = Model?.ToList() ?? new List<Product>();
}

<section class="container py-5">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <div class="p-5 rounded-4" style="background: linear-gradient(135deg, #4f2f22 0%, #8d5d3a 100%); color:#fff;">
                <span class="badge rounded-pill mb-3" style="background: rgba(255,255,255,.15);">Guest checkout bằng số điện thoại</span>
                <h1 class="display-5 fw-bold mb-3">Tinh hoa trầm hương cho không gian sống và quà tặng.</h1>
                <p class="lead mb-4">Bản storefront hiện tại đã được ghép lại theo luồng mua hàng cốt lõi: xem sản phẩm, thêm giỏ, thanh toán, tra cứu đơn bằng OTP.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#san-pham" class="btn btn-light btn-lg px-4">Xem sản phẩm</a>
                    <a asp-controller="OrderLookup" asp-action="Index" class="btn btn-outline-light btn-lg px-4">Tra cứu đơn</a>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="p-4 rounded-4 h-100" style="background: rgba(255,250,245,.85); border:1px solid #e6d6c7;">
                <h5 class="fw-bold mb-3">Danh mục nổi bật</h5>
                <div class="row g-3">
                    @if (categories.Any())
                    {
                        foreach (var category in categories)
                        {
                            <div class="col-6">
                                <div class="rounded-4 p-3 h-100" style="background:#fff; border:1px solid #efe3d7;">
                                    <div class="fw-semibold">@category.CategoryName</div>
                                    <div class="small text-secondary">Sản phẩm theo nhóm trầm hương</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-secondary">Chưa có dữ liệu danh mục.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container pb-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="p-4 rounded-4 h-100" style="background:#fff; border:1px solid #ead8c9;">
                <div class="fw-bold mb-2">Server-rendered storefront</div>
                <div class="text-secondary">Phù hợp với nền ASP.NET Core MVC hiện tại, dễ hoàn thiện tiếp theo spec mà không phải thay kiến trúc đột ngột.</div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="p-4 rounded-4 h-100" style="background:#fff; border:1px solid #ead8c9;">
                <div class="fw-bold mb-2">Giỏ hàng qua session</div>
                <div class="text-secondary">Luồng thêm, cập nhật và đặt hàng đang bám trên nền code có sẵn để đẩy nhanh MVP.</div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="p-4 rounded-4 h-100" style="background:#fff; border:1px solid #ead8c9;">
                <div class="fw-bold mb-2">Tra cứu đơn bằng OTP</div>
                <div class="text-secondary">Khách vãng lai có thể xác thực số điện thoại rồi xem lại đơn hàng đã tạo.</div>
            </div>
        </div>
    </div>
</section>

<section class="container py-4">
    <h2 class="h3 fw-bold mb-3">Sản phẩm nổi bật</h2>
    <div class="row g-4">
        @foreach (var item in featuredProducts)
        {
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <div class="ratio ratio-1x1 rounded-4 mb-3 overflow-hidden" style="background:#f3ece5;">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="object-fit:cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-secondary">Không có ảnh</div>
                            }
                        </div>
                        <div class="small text-secondary mb-2">Mã sản phẩm #@item.Id</div>
                        <h3 class="h6 fw-bold">@item.ProductName</h3>
                        <p class="text-secondary small">@(string.IsNullOrWhiteSpace(item.Description) ? "Sản phẩm trầm hương dành cho nhu cầu sử dụng hằng ngày." : item.Description)</p>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 pb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="fw-bold text-danger">@((item.PriceAfterDiscount > 0 ? item.PriceAfterDiscount : item.OriginalPrice).ToString("N0"))đ</div>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm rounded-pill">Chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container py-4" id="san-pham">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 fw-bold mb-0">Tất cả sản phẩm</h2>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="searchValue" value="@ViewBag.SearchValue" class="form-control rounded-pill" placeholder="Tìm theo tên sản phẩm" />
            <button type="submit" class="btn btn-dark rounded-pill px-4">Tìm</button>
        </form>
    </div>
    <div class="row g-4">
        @if (!allProducts.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning rounded-4">Chưa có sản phẩm nào trong hệ thống.</div>
            </div>
        }
        else
        {
            foreach (var item in allProducts)
            {
                <div class="col-md-6">
                    <div class="p-4 rounded-4 h-100" style="background:#fff; border:1px solid #ead8c9;">
                        <div class="row g-3 align-items-center">
                            <div class="col-4">
                                <div class="ratio ratio-1x1 rounded-4 overflow-hidden" style="background:#f3ece5;">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center text-secondary">Không có ảnh</div>
                                    }
                                </div>
                            </div>
                            <div class="col-8">
                                <h3 class="h5 fw-bold">@item.ProductName</h3>
                                <div class="text-secondary small mb-2">Thành phần: @(item.Ingredient ?? "Đang cập nhật")</div>
                                <div class="text-secondary small mb-3">Thời gian cháy: @(item.BurningTime ?? "Đang cập nhật")</div>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="fw-bold text-danger">@((item.PriceAfterDiscount > 0 ? item.PriceAfterDiscount : item.OriginalPrice).ToString("N0"))đ</span>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm rounded-pill">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
