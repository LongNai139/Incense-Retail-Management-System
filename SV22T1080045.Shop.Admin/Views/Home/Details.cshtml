@* @model SV22T1080045.Shop.DomainModels.Product *@
@* @{ *@
@*     ViewBag.Title = Model.ProductName; *@

@*     string imgUrl = "https://placehold.co/400x400?text=No+Image"; *@
@*     if (!string.IsNullOrEmpty(Model.Photo)) *@
@*     { *@
@*         if (Model.Photo.StartsWith("/image") || Model.Photo.Contains("/")) *@
@*         { *@
@*             imgUrl = Model.Photo; *@
@*         } *@
@*         else *@
@*         { *@
@*             imgUrl = $"/image/{Model.Photo}"; *@
@*         } *@
@*     } *@
@* } *@

@* <div class="container mt-5 mb-5"> *@
@*     <div class="card border-0 shadow-sm rounded-4 overflow-hidden"> *@
@*         <div class="row g-0"> *@
@*             <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4"> *@
@*                 <div class="position-relative w-100"> *@
@*                     <img src="@imgUrl" *@
@*                          class="img-fluid rounded-4 shadow-sm w-100" *@
@*                          style="object-fit: contain; max-height: 400px;" *@
@*                          alt="@Model.ProductName" *@
@*                          onerror="this.onerror=null;this.src='https://placehold.co/400x400?text=Error';"> *@
@*                 </div> *@
@*             </div> *@

@*             <div class="col-md-7 p-4 p-md-5"> *@
@*                 <nav aria-label="breadcrumb" class="mb-3"> *@
@*                     <ol class="breadcrumb"> *@
@*                         <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li> *@
@*                         <li class="breadcrumb-item active text-pink" aria-current="page">Chi tiết</li> *@
@*                     </ol> *@
@*                 </nav> *@

@*                 <h1 class="display-6 fw-bold mb-3">@Model.ProductName</h1> *@

@*                 <div class="mb-4"> *@
@*                     <h3 class="text-pink fw-bold d-inline me-3"> *@
@*                         @Model.Price.ToString("N0") ₫ *@
@*                     </h3> *@
@*                     <span class="badge bg-light text-dark border rounded-pill px-3 py-2"> *@
@*                         Đơn vị: @Model.Unit *@
@*                     </span> *@
@*                 </div> *@

@*                 <div class="mb-4"> *@
@*                     <h5 class="fw-bold text-muted">Mô tả sản phẩm:</h5> *@
@*                     <p class="text-secondary" style="line-height: 1.6;"> *@
@*                         @if (string.IsNullOrWhiteSpace(Model.ProductDescription)) *@
@*                         { *@
@*                             <em>Chưa có mô tả chi tiết cho sản phẩm này. Hãy thưởng thức và cảm nhận nhé!</em> *@
@*                         } *@
@*                         else *@
@*                         { *@
@*                             @Model.ProductDescription *@
@*                         } *@
@*                     </p> *@
@*                 </div> *@

@*                 <hr class="text-muted opacity-25 my-4" /> *@

@*                 <form action="/Cart/AddToCart" method="post" class="row g-3 align-items-end"> *@
@*                     <input type="hidden" name="productID" value="@Model.ProductID" /> *@

@*                     <div class="col-auto"> *@
@*                         <label class="form-label fw-bold small text-muted">Số lượng</label> *@
@*                         <div class="input-group"> *@
@*                             <button class="btn btn-outline-secondary" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepDown()">-</button> *@
@*                             <input type="number" name="quantity" class="form-control text-center border-secondary" value="1" min="1" max="99" style="width: 60px;" /> *@
@*                             <button class="btn btn-outline-secondary" type="button" onclick="this.parentNode.querySelector('input[type=number]').stepUp()">+</button> *@
@*                         </div> *@
@*                     </div> *@

@*                     <div class="col"> *@
@*                         <button type="submit" class="btn btn-pink w-100 btn-lg rounded-pill shadow-sm fw-bold"> *@
@*                             <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ *@
@*                         </button> *@
@*                     </div> *@
@*                 </form> *@

@*                 <div class="mt-4 pt-3 border-top"> *@
@*                     <a href="/" class="text-decoration-none text-muted hover-pink"> *@
@*                         <i class="fas fa-long-arrow-alt-left me-2"></i> Quay lại thực đơn *@
@*                     </a> *@
@*                 </div> *@
@*             </div> *@
@*         </div> *@
@*     </div> *@
@* </div> *@

