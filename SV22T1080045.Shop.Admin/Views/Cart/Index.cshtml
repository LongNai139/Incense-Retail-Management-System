@model List<SV22T1080045.Shop.BusinessLayers.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var totalAmount = Model.Sum(x => x.TotalPrice);
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Giỏ hàng của bạn</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill">Tiếp tục mua hàng</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning rounded-4">Giỏ hàng đang trống. Hãy thêm sản phẩm trước khi thanh toán.</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="p-4 rounded-4" style="background:#fff; border:1px solid #ead8c9;">
                    @foreach (var item in Model)
                    {
                        <div class="row g-3 align-items-center py-3 border-bottom">
                            <div class="col-md-5">
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="small text-secondary">Đơn giá: @item.Price.ToString("N0")đ</div>
                            </div>
                            <div class="col-md-3">
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productID" value="@item.ProductID" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" />
                                    <button type="submit" class="btn btn-outline-secondary">Cập nhật</button>
                                </form>
                            </div>
                            <div class="col-md-2 fw-bold text-danger">
                                @item.TotalPrice.ToString("N0")đ
                            </div>
                            <div class="col-md-2 text-md-end">
                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productID" value="@item.ProductID" />
                                    <button type="submit" class="btn btn-link text-danger text-decoration-none p-0">Xóa</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="p-4 rounded-4" style="background:#fff; border:1px solid #ead8c9;">
                    <h2 class="h5 fw-bold mb-3">Tóm tắt đơn hàng</h2>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính</span>
                        <span>@totalAmount.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Giảm giá</span>
                        <span>0đ</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                        <span>Tổng cộng</span>
                        <span class="text-danger">@totalAmount.ToString("N0")đ</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-dark rounded-pill">Tiến hành thanh toán</a>
                        <form asp-controller="Cart" asp-action="ClearCart" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger rounded-pill w-100">Xóa toàn bộ</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</section>
