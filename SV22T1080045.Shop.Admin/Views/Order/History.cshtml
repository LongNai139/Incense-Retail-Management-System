@* @model List<SV22T1080045.Shop.DomainModels.> *@
@* @{ *@
@*     ViewBag.Title = "Lịch sử mua hàng"; *@
@* } *@

@* @section Styles { *@
@*     <style> *@
@*         .history-container { *@
@*             background: #fff; *@
@*             border-radius: 20px; *@
@*             padding: 30px; *@
@*             box-shadow: 0 10px 30px rgba(0,0,0,0.05); *@
@*             min-height: 60vh; *@
@*         } *@

@*         .page-title { *@
@*             color: #00a0e9; *@
@*             font-weight: 700; *@
@*             margin-bottom: 25px; *@
@*             position: relative; *@
@*             padding-bottom: 15px; *@
@*         } *@

@*             .page-title::after { *@
@*                 content: ''; *@
@*                 position: absolute; *@
@*                 left: 0; *@
@*                 bottom: 0; *@
@*                 width: 50px; *@
@*                 height: 4px; *@
@*                 background-color: #ff9800; *@
@*                 border-radius: 2px; *@
@*             } *@

@*         .table-custom thead th { *@
@*             background-color: #f4f8fb; *@
@*             color: #555; *@
@*             font-weight: 600; *@
@*             border: none; *@
@*             padding: 15px; *@
@*             font-size: 0.9rem; *@
@*             text-transform: uppercase; *@
@*             letter-spacing: 0.5px; *@
@*         } *@

@*         .table-custom tbody tr { *@
@*             border-bottom: 1px solid #f1f1f1; *@
@*             transition: all 0.2s; *@
@*         } *@

@*             .table-custom tbody tr:last-child { *@
@*                 border-bottom: none; *@
@*             } *@

@*             .table-custom tbody tr:hover { *@
@*                 background-color: #fafbfc; *@
@*                 transform: scale(1.005); *@
@*             } *@

@*         .table-custom td { *@
@*             padding: 15px; *@
@*             vertical-align: middle; *@
@*             color: #333; *@
@*         } *@

@*         .status-badge { *@
@*             padding: 6px 12px; *@
@*             border-radius: 30px; *@
@*             font-size: 0.8rem; *@
@*             font-weight: 600; *@
@*             display: inline-flex; *@
@*             align-items: center; *@
@*             gap: 5px; *@
@*         } *@

@*         .status-waiting { *@
@*             background-color: #fff3cd; *@
@*             color: #856404; *@
@*         } *@
@*         .status-success { *@
@*             background-color: #d1e7dd; *@
@*             color: #0f5132; *@
@*         } *@
@*         .status-danger { *@
@*             background-color: #f8d7da; *@
@*             color: #842029; *@
@*         } *@
@*         .status-primary { *@
@*             background-color: #cfe2ff; *@
@*             color: #084298; *@
@*         } *@
@*         .status-shipping { *@
@*             background-color: #e2e3e5; *@
@*             color: #41464b; *@
@*         } *@

@*         .btn-detail { *@
@*             background-color: #fff; *@
@*             border: 1px solid #00a0e9; *@
@*             color: #00a0e9; *@
@*             border-radius: 20px; *@
@*             padding: 5px 15px; *@
@*             font-size: 0.85rem; *@
@*             font-weight: 500; *@
@*             transition: 0.3s; *@
@*         } *@

@*             .btn-detail:hover { *@
@*                 background-color: #00a0e9; *@
@*                 color: #fff; *@
@*             } *@

@*         /* Empty State */ *@
@*         .empty-state-icon { *@
@*             font-size: 4rem; *@
@*             color: #ddd; *@
@*             margin-bottom: 15px; *@
@*         } *@
@*     </style> *@
@* } *@

@* <div class="container my-4"> *@
@*     <div class="history-container"> *@
@*         <h3 class="page-title"> *@
@*             <i class="bi bi-clock-history me-2"></i>Lịch sử đơn hàng *@
@*         </h3> *@

@*         @if (Model == null || Model.Count == 0) *@
@*         { *@
@*             <div class="text-center py-5"> *@
@*                 <i class="bi bi-cart-x empty-state-icon"></i> *@
@*                 <h5 class="text-muted fw-bold">Bạn chưa có đơn hàng nào</h5> *@
@*                 <p class="text-muted mb-4">Hãy khám phá thực đơn hấp dẫn của chúng tôi nhé!</p> *@
@*                 <a href="/Home/Search" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm" style="background-color: #00a0e9; border:none;"> *@
@*                     Xem thực đơn ngay *@
@*                 </a> *@
@*             </div> *@
@*         } *@
@*         else *@
@*         { *@
@*             <div class="table-responsive"> *@
@*                 <table class="table table-custom mb-0"> *@
@*                     <thead> *@
@*                         <tr> *@
@*                             <th class="ps-3 rounded-start">Mã đơn</th> *@
@*                             <th>Ngày đặt</th> *@
@*                             <th>Địa chỉ giao</th> *@
@*                             <th>Tổng tiền</th> *@
@*                             <th>Trạng thái</th> *@
@*                             <th class="text-center rounded-end">Thao tác</th> *@
@*                         </tr> *@
@*                     </thead> *@
@*                     <tbody> *@
@*                         @foreach (var item in Model) *@
@*                         { *@
@*                             <tr> *@
@*                                 <td class="ps-3 fw-bold text-primary"> *@
@*                                     <i class="bi bi-receipt me-1"></i>#@item.OrderID *@
@*                                 </td> *@
@*                                 <td> *@
@*                                     <div class="d-flex flex-column"> *@
@*                                         <span class="fw-bold">@item.OrderTime.ToString("dd/MM/yyyy")</span> *@
@*                                         <small class="text-muted">@item.OrderTime.ToString("HH:mm")</small> *@
@*                                     </div> *@
@*                                 </td> *@
@*                                 <td style="max-width: 250px;"> *@
@*                                     <div class="text-truncate" title="@item.DeliveryAddress"> *@
@*                                         <i class="bi bi-geo-alt text-muted me-1"></i>@item.DeliveryAddress *@
@*                                     </div> *@
@*                                 </td> *@
@*                                 <td class="fw-bold text-dark"> *@
@*                                     @item.TotalAmount.ToString("N0")₫ *@
@*                                 </td> *@
@*                                 <td> *@
@*                                     @{ *@
@*                                         string statusClass = "status-primary"; *@
@*                                         string iconClass = "bi-info-circle"; *@

@*                                         if (item.Status.Contains("Chờ") || item.Status == "Khởi tạo") *@
@*                                         { *@
@*                                             statusClass = "status-waiting"; *@
@*                                             iconClass = "bi-hourglass-split"; *@
@*                                         } *@
@*                                         else if (item.Status.Contains("Giao hàng") || item.Status == "Đang vận chuyển") *@
@*                                         { *@
@*                                             statusClass = "status-shipping"; *@
@*                                             iconClass = "bi-truck"; *@
@*                                         } *@
@*                                         else if (item.Status == "Hoàn tất" || item.Status == "Đã giao hàng") *@
@*                                         { *@
@*                                             statusClass = "status-success"; *@
@*                                             iconClass = "bi-check-circle-fill"; *@
@*                                         } *@
@*                                         else if (item.Status == "Đã hủy" || item.Status == "Bị từ chối") *@
@*                                         { *@
@*                                             statusClass = "status-danger"; *@
@*                                             iconClass = "bi-x-circle-fill"; *@
@*                                         } *@
@*                                     } *@
@*                                     <span class="status-badge @statusClass"> *@
@*                                         <i class="bi @iconClass"></i> @item.Status *@
@*                                     </span> *@
@*                                 </td> *@
@*                                 <td class="text-center"> *@
@*                                     <a href="/Order/Details/@item.OrderID" class="btn btn-detail"> *@
@*                                         Chi tiết *@
@*                                     </a> *@
@*                                 </td> *@
@*                             </tr> *@
@*                         } *@
@*                     </tbody> *@
@*                 </table> *@
@*             </div> *@
@*         } *@
@*     </div> *@
@* </div> *@