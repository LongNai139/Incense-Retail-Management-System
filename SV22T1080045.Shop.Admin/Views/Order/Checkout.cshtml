@model SV22T1080045.Shop.DomainModels.Customers
@{
    ViewBag.Title = "Thanh toán";
    var cart = ViewBag.Cart as List<SV22T1080045.Shop.DomainModels.CartItem> ?? new List<SV22T1080045.Shop.DomainModels.CartItem>();
    decimal total = cart.Sum(x => x.TotalPrice);

    if (!cart.Any())
    {
        <div class="container my-5 text-center">
            <div class="py-5">
                <i class="fa-solid fa-basket-shopping display-1 text-muted mb-4"></i>
                <h3>Giỏ hàng của bạn đang trống</h3>
                <p class="text-muted">Vui lòng chọn sản phẩm trước khi thanh toán.</p>
                <a href="/" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
            </div>
        </div>
        return;
    }
}

@section Styles {
    <style>
        .checkout-container {
            max-width: 1100px;
        }

        .card-custom {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            background: #fff;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .card-header-custom {
            background-color: #fff;
            border-bottom: 1px solid #edf2f9;
            padding: 20px 25px;
        }

        .input-group-text {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            border-right: none;
            color: #8898aa;
            min-width: 45px;
            justify-content: center;
        }

        .form-control {
            border: 1px solid #e9ecef;
            border-left: none;
            padding: 12px 15px;
            font-size: 0.95rem;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: #00a0e9;
            }

                .form-control:focus + .input-group-text,
                .input-group:focus-within .input-group-text {
                    border-color: #00a0e9;
                    color: #00a0e9;
                    background-color: #fff;
                }

        .input-group:focus-within .form-control {
            border-color: #00a0e9;
        }

        .form-control[readonly] {
            background-color: #f6f9fc;
            color: #525f7f;
            font-weight: 500;
        }

        .summary-sticky {
            position: sticky;
            top: 100px; 
        }

        .product-thumb {
            width: 56px;
            height: 56px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #eee;
        }

        .btn-confirm {
            background: linear-gradient(135deg, #00a0e9 0%, #007bb3 100%);
            border: none;
            border-radius: 8px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

            .btn-confirm:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0, 160, 233, 0.35);
                background: linear-gradient(135deg, #0093d5 0%, #006da0 100%);
            }

        /* Payment Method */
        .payment-method-box {
            border: 2px solid #00a0e9;
            background-color: #f4fbff;
            border-radius: 10px;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .required-star {
            color: #dc3545;
            margin-left: 3px;
        }
    </style>
}

<div class="container checkout-container my-5" style="min-height: 80vh;">
    <div class="d-flex align-items-center mb-4">
        <a href="/Cart" class="btn btn-white border rounded-circle me-3 shadow-sm text-secondary"
           style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h3 class="fw-bold m-0 text-dark">Xác nhận đơn hàng</h3>
            <small class="text-muted">Vui lòng kiểm tra kỹ thông tin trước khi đặt hàng</small>
        </div>
    </div>

    <form action="/Order/Checkout" method="post">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-custom">
                    <div class="card-header-custom">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-circle-user me-2 text-secondary"></i>Thông tin người đặt
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Họ tên</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                    <input type="text" class="form-control" value="@Model.CustomerName" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                                    <input type="text" class="form-control" value="@Model.Email" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-custom">
                    <div class="card-header-custom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-primary">
                            <i class="fa-solid fa-truck-fast me-2"></i>Thông tin giao hàng
                        </h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Quan trọng</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Số điện thoại nhận hàng <span class="required-star">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                <input type="text" name="deliveryPhone" class="form-control"
                                       placeholder="Nhập số điện thoại liên hệ..." required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ nhận hàng <span class="required-star">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                                <input type="text" name="deliveryAddress" class="form-control"
                                       value="@Model.Address" placeholder="Số nhà, đường, phường/xã, quận/huyện..." required />
                            </div>
                            <div class="form-text text-muted mt-2">
                                <i class="fa-solid fa-circle-info me-1 text-info"></i>
                                Shipper sẽ gọi điện xác nhận trước khi giao hàng.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-custom">
                    <div class="card-header-custom">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-wallet me-2 text-secondary"></i>Phương thức thanh toán
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="payment-method-box">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="cod" checked>
                                <label class="form-check-label fw-bold text-dark" for="cod">
                                    Thanh toán khi nhận hàng (COD)
                                </label>
                            </div>
                            <i class="fa-solid fa-money-bill-wave fs-3 text-success"></i>
                        </div>
                        <div class="mt-3 ps-1">
                            <small class="text-muted"><i class="fa-solid fa-shield-halved me-1"></i>Thông tin thanh toán của bạn được bảo mật an toàn.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card-custom summary-sticky">
                    <div class="card-header-custom bg-light">
                        <h5 class="mb-0 fw-bold">Đơn hàng của bạn (@cart.Count món)</h5>
                    </div>

                    <div class="card-body p-0">
                        <div class="overflow-auto custom-scrollbar" style="max-height: 400px;">
                            <table class="table table-borderless align-middle mb-0">
                                <tbody>
                                    @foreach (var item in cart)
                                    {
                                        <tr class="border-bottom">
                                            <td class="ps-4 py-3" style="width: 70px;">
                                                @{
                                                    string imgUrl = "https://placehold.co/60"; 
                                                    if (!string.IsNullOrEmpty(item.Photo))
                                                    {
                                                        if (item.Photo.Contains("/"))
                                                        {
                                                            imgUrl = item.Photo;
                                                        }
                                                        else
                                                        {
                                                            imgUrl = $"/image/{item.Photo}";
                                                        }
                                                    }
                                                }

                                                <img src="@imgUrl"
                                                     class="product-thumb"
                                                     alt="@item.ProductName"
                                                     onerror="this.src='https://placehold.co/60'" />
                                            </td>
                                            <td class="py-3">
                                                <div class="fw-bold text-dark text-truncate" style="max-width: 180px;" title="@item.ProductName">
                                                    @item.ProductName
                                                </div>
                                                <div class="small text-muted mt-1">
                                                    @item.Price.ToString("N0")₫ x <span class="fw-bold text-dark">@item.Quantity</span>
                                                </div>
                                            </td>
                                            <td class="text-end pe-4 py-3 fw-bold text-primary">
                                                @item.TotalPrice.ToString("N0")₫
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-white p-4 border-top">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Tạm tính</span>
                            <span class="fw-bold">@total.ToString("N0")₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-secondary">Phí vận chuyển</span>
                            <span class="text-success fw-bold">
                                <i class="fa-solid fa-check me-1"></i>Miễn phí
                            </span>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="h6 fw-bold mb-0 text-dark">Tổng thanh toán</span>
                            <span class="h3 fw-bold text-danger mb-0">@total.ToString("N0")₫</span>
                        </div>

                        <button type="submit" class="btn btn-confirm w-100 py-3 text-white text-uppercase shadow">
                            <i class="fa-solid fa-check-circle me-2"></i> Xác nhận đặt hàng
                        </button>
                        <div class="text-center mt-3">
                            <a href="/Cart" class="text-decoration-none small text-muted">
                                <i class="fa-solid fa-angle-left me-1"></i>Quay lại giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>