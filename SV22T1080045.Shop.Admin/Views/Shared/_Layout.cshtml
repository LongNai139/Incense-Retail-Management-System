@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using SV22T1080045.Shop.BusinessLayers
@inject IHttpContextAccessor HttpContextAccessor
@{
    var cartJson = HttpContextAccessor.HttpContext?.Session.GetString("SHOP_CART");
    var cart = string.IsNullOrWhiteSpace(cartJson)
        ? new List<CartItem>()
        : JsonConvert.DeserializeObject<List<CartItem>>(cartJson) ?? new List<CartItem>();
    var cartCount = cart.Sum(x => x.Quantity);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trầm Hương Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/SV22T1080045.Shop.Admin.styles.css" asp-append-version="true" />
    <style>
        :root {
            --bg: #f6f0e8;
            --text: #2e2018;
            --muted: #7b6a5f;
            --accent: #7a4b2e;
            --accent-2: #b67a45;
            --line: #e6d6c7;
        }

        body {
            background:
                radial-gradient(circle at top right, rgba(182, 122, 69, .18), transparent 24%),
                linear-gradient(180deg, #fbf7f2 0%, var(--bg) 100%);
            color: var(--text);
        }

        .site-header {
            background: rgba(255, 250, 245, .92);
            border-bottom: 1px solid rgba(122, 75, 46, .1);
            backdrop-filter: blur(14px);
        }

        .navbar-brand {
            color: var(--accent) !important;
            font-weight: 700;
            letter-spacing: .02em;
        }

        .nav-link {
            color: var(--muted) !important;
            font-weight: 600;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--accent) !important;
        }

        .nav-pill {
            background: var(--accent);
            color: #fff;
            border-radius: 999px;
            padding: .6rem 1rem;
            text-decoration: none;
            font-weight: 600;
        }

        .nav-pill:hover {
            background: var(--accent-2);
            color: #fff;
        }

        .icon-link {
            width: 42px;
            height: 42px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line);
            color: var(--accent);
            background: #fff;
            position: relative;
            text-decoration: none;
        }

        .icon-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            background: #b93b2a;
            color: #fff;
            border-radius: 999px;
            font-size: .75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .page-shell {
            min-height: calc(100vh - 180px);
            padding-top: 88px;
        }

        footer {
            background: #2d2019;
            color: #f3e9de;
        }

        footer a {
            color: #dbc7b4;
            text-decoration: none;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header fixed-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container py-2">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Trầm Hương Shop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="san-pham">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="OrderLookup" asp-action="Index">Tra cứu đơn</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Quản lý</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="icon-link" asp-controller="OrderLookup" asp-action="Index" title="Tra cứu đơn hàng">
                            <i class="fa-solid fa-receipt"></i>
                        </a>
                        <a class="icon-link" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                            <i class="fa-solid fa-bag-shopping"></i>
                            @if (cartCount > 0)
                            {
                                <span class="icon-badge">@cartCount</span>
                            }
                        </a>
                        <a class="nav-pill" asp-controller="Checkout" asp-action="Index">Thanh toán</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-shell">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="py-5 mt-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h5 class="mb-3">Trầm Hương Shop</h5>
                    <p class="mb-0">Website bán hương trầm, sản phẩm trầm và quà tặng phong cách Việt Nam. Tập trung trải nghiệm mua hàng đơn giản cho khách vãng lai lẫn thành viên.</p>
                </div>
                <div class="col-lg-3">
                    <h6 class="mb-3">Điều hướng</h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                        <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                        <a asp-controller="OrderLookup" asp-action="Index">Tra cứu đơn hàng</a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <h6 class="mb-3">Liên hệ</h6>
                    <div class="d-flex flex-column gap-2">
                        <span>Hotline: 0909 123 456</span>
                        <span>Zalo OA: TramHuongShop</span>
                        <span>Địa chỉ: TP. Ho Chi Minh</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
