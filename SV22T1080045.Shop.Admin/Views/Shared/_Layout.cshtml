@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var searchValue = ViewBag.SearchValue as string ?? string.Empty;
    var storefrontUrl = (Configuration["AppHosts:StorefrontUrl"] ?? "https://localhost:7126").TrimEnd('/');
    var isAdmin = User.IsInRole(SV22T1080045.Shop.DomainModels.CustomerRoles.Admin);
    var isStaff = User.IsInRole(SV22T1080045.Shop.DomainModels.CustomerRoles.Staff);
    var workspaceHome = isAdmin
        ? Url.Action("Index", "Management")!
        : Url.Action("Index", "Staff")!;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trầm Hương Shop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="nav-inner">
            <a class="nav-logo" href="@workspaceHome">
                <div class="logo-icon">T</div>
                <div class="logo-text">
                    Trầm Hương
                    <span>Shop</span>
                </div>
            </a>

            <form class="nav-search" method="get" action="@($"{storefrontUrl}/")" target="_blank" rel="noopener">
                <i class="fa fa-search nav-search-icon"></i>
                <input type="text" name="searchValue" value="@searchValue" placeholder="Tìm sản phẩm (cửa hàng)..." />
            </form>

            <nav class="nav-links" aria-label="Điều hướng chính">
                <a href="@storefrontUrl" target="_blank" rel="noopener">Trang chủ</a>
                <a href="@($"{storefrontUrl}/Product")" target="_blank" rel="noopener">Sản phẩm</a>
                <a href="@($"{storefrontUrl}/Cart")" target="_blank" rel="noopener">Giỏ hàng</a>
            </nav>

            <div class="nav-actions">
                <a class="nav-btn nav-btn-ghost nav-btn-compact" href="@($"{storefrontUrl}/tra-cuu-don-hang")" target="_blank" rel="noopener" title="Tra cứu đơn hàng">
                    <i class="fa-solid fa-receipt"></i>
                    <span class="nav-btn-label">Tra cứu</span>
                </a>

                @await Component.InvokeAsync("CartBadge")

                <div class="nav-account">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-dropdown" data-nav-dropdown>
                            <button type="button" class="nav-btn nav-btn-ghost nav-btn-compact nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                                <i class="fa-solid fa-user"></i>
                                <span class="nav-btn-label">@(User.Identity?.Name ?? "Tài khoản")</span>
                                <i class="fa-solid fa-chevron-down nav-dropdown-caret" aria-hidden="true"></i>
                            </button>
                            <div class="nav-dropdown-menu" role="menu">
                                <a role="menuitem" asp-controller="Account" asp-action="Profile">
                                    <i class="fa-solid fa-id-card"></i> Hồ sơ
                                </a>
                                @if (isStaff || isAdmin)
                                {
                                    <a role="menuitem" asp-controller="Staff" asp-action="Index">
                                        <i class="fa-solid fa-headset"></i> Staff
                                    </a>
                                }
                                @if (isAdmin)
                                {
                                    <a role="menuitem" asp-controller="Management" asp-action="Index">
                                        <i class="fa-solid fa-chart-line"></i> Quản lý
                                    </a>
                                    <a role="menuitem" asp-controller="System" asp-action="Index">
                                        <i class="fa-solid fa-gear"></i> Hệ thống
                                    </a>
                                }
                                <div class="nav-dropdown-divider" role="separator"></div>
                                <a role="menuitem" asp-controller="Account" asp-action="Logout">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="nav-btn nav-btn-solid" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-custom">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="logo-text">
                        Trầm Hương
                        <span>Shop</span>
                    </div>
                    <p class="footer-desc">
                        Sản phẩm trầm hương thiên nhiên, quà tặng tinh tế và giải pháp hương thơm cho không gian sống.
                    </p>
                </div>
                <div>
                    <div class="footer-col-title">Điều hướng</div>
                    <ul class="footer-links">
                        <li><a href="@storefrontUrl" target="_blank" rel="noopener">Trang chủ</a></li>
                        <li><a href="@($"{storefrontUrl}/Product")" target="_blank" rel="noopener">Sản phẩm</a></li>
                        <li><a href="@($"{storefrontUrl}/Cart")" target="_blank" rel="noopener">Giỏ hàng</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <div>© 2026 Trầm Hương Shop · Quản trị</div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
