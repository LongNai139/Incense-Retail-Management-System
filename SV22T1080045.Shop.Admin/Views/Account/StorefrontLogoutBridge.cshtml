@{
    Layout = null;
    var logoutUrl = ViewBag.StorefrontLogoutUrl as string ?? "";
    var loginUrl = ViewBag.StorefrontLoginUrl as string ?? Url.Action("Login", "Account")!;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đang đăng xuất...</title>
    <style>
        body {
            font-family: "Be Vietnam Pro", Arial, sans-serif;
            background: #2b1d14;
            color: #f3e6d0;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        a {
            color: #e0b95c;
        }
    </style>
</head>
<body>
    <p>Đang đăng xuất... <a href="@loginUrl">Về trang đăng nhập</a></p>

    <script>
        (function () {
            var logoutUrl = @Json.Serialize(logoutUrl);
            var loginUrl = @Json.Serialize(loginUrl);
            var redirected = false;

            function goLogin() {
                if (redirected) return;
                redirected = true;
                window.location.replace(loginUrl);
            }

            // Phòng khi cửa hàng không phản hồi: vẫn chuyển sau 2 giây
            window.setTimeout(goLogin, 2000);

            if (!logoutUrl) { goLogin(); return; }

            // Gọi ngầm, không chuyển trang nên không bị hiện chữ "OK"
            fetch(logoutUrl, { method: 'POST', mode: 'no-cors', credentials: 'include' })
                .then(goLogin, goLogin);
        })();
    </script>
</body>
</html>
