@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập — Trầm Hương Shop</title>

    @* 2. Nhúng Font *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet">

    @* 3. Nhúng CSS trực tiếp (Vì Layout = null nên @section Styles sẽ không hoạt động) *@
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-page">
        <!-- HEADER -->
        <header class="site-header">
            <a href="@Url.Action("Index", "Home")" class="nav-logo">
                <div class="logo-icon">🌿</div>
                <div class="logo-text">Trầm Hương Shop<span>Hương Trầm Việt Nam</span></div>
            </a>
            <div class="header-right">
                Chưa có tài khoản? <a href="#" onclick="switchTab('register')">Đăng ký ngay</a>
            </div>
        </header>

        <div class="page">
            <!-- LEFT DECORATIVE PANEL -->
            <div class="left-panel">
                <div class="left-bg-num">🌿</div>
                <div class="left-content">
                    <div class="left-icon">🪔</div>
                    <h2 class="left-title">Chào mừng đến với<br><em>Trầm Hương Shop</em></h2>
                    <p class="left-sub">Đăng nhập hoặc tạo tài khoản để trải nghiệm mua sắm tốt hơn</p>
                    <div class="benefit-list">
                        <div class="benefit-item">
                            <span class="benefit-icon">📦</span>
                            <div class="benefit-text">
                                <strong>Theo dõi đơn hàng dễ dàng</strong>
                                Xem lịch sử, trạng thái đơn bất cứ lúc nào
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">📍</span>
                            <div class="benefit-text">
                                <strong>Lưu địa chỉ giao hàng</strong>
                                Thanh toán nhanh hơn ở lần mua sau
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">❤️</span>
                            <div class="benefit-text">
                                <strong>Danh sách yêu thích</strong>
                                Lưu sản phẩm, theo dõi khi có Flash Sale
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">🎁</span>
                            <div class="benefit-text">
                                <strong>Ưu đãi thành viên</strong>
                                Nhận thông báo khuyến mãi độc quyền
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT FORM PANEL -->
            <div class="right-panel">
                <div class="form-box">
                    <!-- TABS -->
                    <div class="form-tabs">
                        <div class="form-tab active" id="tab-login" onclick="switchTab('login')">Đăng nhập</div>
                        <div class="form-tab" id="tab-register" onclick="switchTab('register')">Đăng ký</div>
                    </div>

                    <!-- ─── LOGIN SECTION ─── -->
                    <div class="form-section active" id="section-login">
                        <!-- Step 1: Phone -->
                        <div id="login-step1">
                            <h2 class="form-title">Đăng nhập</h2>
                            <p class="form-sub">Nhập số điện thoại để tiếp tục. Chúng tôi sẽ gửi mã OTP xác thực.</p>

                            <form id="formLogin" method="post" asp-controller="Account" asp-action="Login">
                                @Html.AntiForgeryToken()
                                <div class="field">
                                    <label class="field-label">Số điện thoại <span>*</span></label>
                                    <div class="field-input-wrap">
                                        <span class="field-prefix">🇻🇳</span>
                                        <input type="tel" name="Phone" class="field-input has-prefix" id="login-phone" placeholder="Nhập số điện thoại" maxlength="10" required>
                                    </div>
                                <div class="field-error" id="login-err-msg">@ViewBag.ErrorMessage</div>
                                </div>

                                <div class="field">
                                    <label class="field-label">Mật khẩu <span>*</span></label>
                                    <input class="field-input" type="password" name="Password" id="login-password" placeholder="Nhập mật khẩu..." required>
                                </div>

                                <button type="submit" class="btn-primary" style="margin-bottom:12px;">
                                    Đăng nhập
                                </button>
                            </form>

                            @* <button class="btn-primary" onclick="sendLoginOTP()"> *@
                            @*     Gửi mã OTP → *@
                            @* </button> *@

                            @* <div class="divider">hoặc đăng nhập bằng mật khẩu</div> *@

                            <div style="text-align:right;margin-top:-4px;">
                                <a href="#" style="font-size:13px;color:var(--ink-3);">Quên mật khẩu?</a>
                            </div>

                            <div class="divider">hoặc</div>
                            <div class="social-btns">
                                <button class="social-btn">📘 Facebook</button>
                                <button class="social-btn">🔴 Google</button>
                            </div>
                            <div class="helper-row">Chưa có tài khoản? <a href="#" onclick="switchTab('register')">Đăng ký ngay</a></div>
                        </div>

                        <!-- Step 2: OTP -->
                        <div id="login-step2" style="display:none;">
                            <h2 class="form-title">Nhập mã OTP</h2>
                            <p class="form-sub">Mã 6 số đã được gửi đến <strong id="login-phone-display"></strong></p>

                            <div class="field" style="margin-bottom:12px;">
                                <div class="otp-wrap" id="login-otp-wrap">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'login')" onkeydown="otpKeydown(event,this)">
                                </div>
                                <div class="otp-timer-row">
                                    <span class="otp-timer">Hết hạn sau <strong id="login-otp-timer">5:00</strong></span>
                                    <span class="otp-resend disabled" id="login-resend" onclick="resendOTP('login')">Gửi lại OTP</span>
                                </div>
                            </div>

                            <button class="btn-primary" onclick="verifyLoginOTP()" id="login-verify-btn" disabled>Xác nhận →</button>
                            <button class="btn-outline" style="margin-top:10px;" onclick="backToPhone('login')">← Đổi số điện thoại</button>
                        </div>

                        <!-- Step 3: Success -->
                        <div id="login-step3" style="display:none;">
                            <div class="success-box">
                                <div class="success-icon">✅</div>
                                <div class="success-title">Đăng nhập thành công!</div>
                                <p class="success-sub">Chào mừng bạn quay trở lại.<br>Đang chuyển hướng về trang chủ...</p>
                                <button class="btn-primary" onclick="location.href='@Url.Action("Index", "Home")'">Về trang chủ</button>
                            </div>
                        </div>
                    </div>

                    <!-- ─── REGISTER SECTION ─── -->
                    <div class="form-section" id="section-register">
                        <!-- Steps indicator -->
                        <div class="steps" id="reg-steps">
                            <div class="step-item">
                                <div class="step-circle active" id="reg-s1">1</div>
                                <div class="step-label active">Số điện thoại</div>
                            </div>
                            <div class="step-line" id="reg-line1"></div>
                            <div class="step-item">
                                <div class="step-circle pending" id="reg-s2">2</div>
                                <div class="step-label" id="reg-s2-lbl">Xác thực OTP</div>
                            </div>
                            <div class="step-line" id="reg-line2"></div>
                            <div class="step-item">
                                <div class="step-circle pending" id="reg-s3">3</div>
                                <div class="step-label" id="reg-s3-lbl">Mật khẩu</div>
                            </div>
                        </div>

                        <!-- Reg Step 1 -->
                        <div id="reg-step1">
                            <h2 class="form-title">Tạo tài khoản</h2>
                            <p class="form-sub">Chỉ cần số điện thoại — không cần email, không cần phức tạp.</p>

                            <div class="field">
                                <label class="field-label">Họ và tên <span>*</span></label>
                                <input class="field-input" type="text" id="reg-name" placeholder="Nguyễn Văn A">
                                <div class="field-error" id="reg-name-err">Vui lòng nhập họ tên</div>
                            </div>
                            <div class="field">
                                <label class="field-label">Số điện thoại <span>*</span></label>
                                <div class="field-input-wrap">
                                    <span class="field-prefix">🇻🇳</span>
                                    <input class="field-input has-prefix" type="tel" id="reg-phone" placeholder="0901 234 567" maxlength="11" oninput="formatPhone(this)">
                                </div>
                                <div class="field-hint">Sẽ dùng để nhận OTP & đăng nhập sau này</div>
                                <div class="field-error" id="reg-phone-err">Vui lòng nhập số điện thoại hợp lệ</div>
                            </div>

                            <button class="btn-primary" onclick="sendRegOTP()">Tiếp tục →</button>
                            <div class="helper-row">Đã có tài khoản? <a href="#" onclick="switchTab('login')">Đăng nhập</a></div>
                        </div>

                        <!-- Reg Step 2: OTP -->
                        <div id="reg-step2" style="display:none;">
                            <h2 class="form-title">Xác thực OTP</h2>
                            <p class="form-sub">Mã 6 số đã gửi đến <strong id="reg-phone-display"></strong></p>

                            <div class="field">
                                <div class="otp-wrap" id="reg-otp-wrap">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                    <input class="otp-input" maxlength="1" type="tel" oninput="otpInput(this,'reg')" onkeydown="otpKeydown(event,this)">
                                </div>
                                <div class="otp-timer-row">
                                    <span class="otp-timer">Hết hạn sau <strong id="reg-otp-timer">5:00</strong></span>
                                    <span class="otp-resend disabled" id="reg-resend" onclick="resendOTP('reg')">Gửi lại OTP</span>
                                </div>
                            </div>

                            <button class="btn-primary" onclick="verifyRegOTP()" id="reg-verify-btn" disabled>Xác nhận →</button>
                            <button class="btn-outline" style="margin-top:10px;" onclick="backToPhone('reg')">← Đổi số điện thoại</button>
                        </div>

                        <!-- Reg Step 3: Password -->
                        <div id="reg-step3" style="display:none;">
                            <h2 class="form-title">Đặt mật khẩu</h2>
                            <p class="form-sub">Tạo mật khẩu để đăng nhập lần sau. Tối thiểu 8 ký tự.</p>

                            <div class="field">
                                <label class="field-label">Mật khẩu <span>*</span></label>
                                <input class="field-input" type="password" id="reg-pw" placeholder="Tối thiểu 8 ký tự" oninput="checkPwStrength(this.value)">
                                <div class="pw-strength" id="pw-strength-wrap">
                                    <div class="pw-bars">
                                        <div class="pw-bar" id="pw-bar-1"></div>
                                        <div class="pw-bar" id="pw-bar-2"></div>
                                        <div class="pw-bar" id="pw-bar-3"></div>
                                        <div class="pw-bar" id="pw-bar-4"></div>
                                    </div>
                                    <span class="pw-label" id="pw-label">Nhập mật khẩu</span>
                                </div>
                            </div>
                            <div class="field">
                                <label class="field-label">Xác nhận mật khẩu <span>*</span></label>
                                <input class="field-input" type="password" id="reg-pw2" placeholder="Nhập lại mật khẩu">
                                <div class="field-error" id="pw-match-err">Mật khẩu không khớp</div>
                            </div>

                            <button class="btn-primary" onclick="completeRegister()">Hoàn tất đăng ký 🎉</button>
                        </div>

                        <!-- Reg Step 4: Done -->
                        <div id="reg-step4" style="display:none;">
                            <div class="success-box">
                                <div class="success-icon">🎉</div>
                                <div class="success-title">Đăng ký thành công!</div>
                                <p class="success-sub">Chào mừng bạn đến với Trầm Hương Shop.<br>Tài khoản đã được tạo thành công.</p>
                                <button class="btn-primary" onclick="location.href='@Url.Action("Index", "Home")'">Bắt đầu mua sắm →</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Toast -->
        <div id="toast"></div>

        <!-- FOOTER -->
        <footer class="site-footer">© 2025 Trầm Hương Shop · Bảo mật thông tin khách hàng</footer>
    </div>

        <form id="registerForm" method="post" asp-controller="Account" asp-action="Register" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CustomerName" id="register-name-hidden" />
            <input type="hidden" name="Phone" id="register-phone-hidden" />
            <input type="hidden" name="Password" id="register-password-hidden" />
            <input type="hidden" name="OtpCode" id="register-otp-hidden" />
        </form>

        <script>
                    // ── HELPERS ─────────────────────────────────────────────────────
            function showToast(msg, duration=2800){
              const t = document.getElementById('toast');
              t.textContent = msg; t.style.opacity='1'; t.style.transform='translateX(-50%) translateY(0)';
              clearTimeout(t._t);
              t._t = setTimeout(()=>{ t.style.opacity='0'; t.style.transform='translateX(-50%) translateY(12px)'; }, duration);
            }
            function formatPhone(el){
              let v = el.value.replace(/\D/g,'');
              el.value = v;
            }
            function validatePhone(v){ return /^(0|\+84)[3-9]\d{8}$/.test(v.replace(/\s/g,'')); }
            function show(id){ document.getElementById(id).style.display='block'; }
            function hide(id){ document.getElementById(id).style.display='none'; }

            // ── OTP INPUTS ───────────────────────────────────────────────────
            function otpInput(el, prefix){
              el.value = el.value.replace(/\D/g,'');
              if(el.value) el.classList.add('filled');
              else el.classList.remove('filled');
              if(el.value && el.nextElementSibling) el.nextElementSibling.focus();
              checkOTPComplete(prefix);
            }
            function otpKeydown(e, el){
              if(e.key==='Backspace' && !el.value && el.previousElementSibling) el.previousElementSibling.focus();
            }
            function getOTPValue(prefix){
              return [...document.querySelectorAll(`#${prefix}-otp-wrap .otp-input`)].map(i=>i.value).join('');
            }
            function checkOTPComplete(prefix){
              const val = getOTPValue(prefix);
              const btn = document.getElementById(`${prefix}-verify-btn`);
              if(btn) btn.disabled = val.length < 6;
            }

            // ── OTP TIMER ────────────────────────────────────────────────────
            let otpTimers = {};
            function startTimer(prefix){
              clearInterval(otpTimers[prefix]);
              let secs = 300;
              const display = document.getElementById(`${prefix}-otp-timer`);
              const resend = document.getElementById(`${prefix}-resend`);
              resend.classList.add('disabled');
              function tick(){
                const m = Math.floor(secs/60), s = secs%60;
                display.textContent = `${m}:${String(s).padStart(2,'0')}`;
                if(secs <= 60) resend.classList.remove('disabled');
                if(secs <= 0){ clearInterval(otpTimers[prefix]); display.textContent='Đã hết hạn'; }
                secs--;
              }
              tick();
              otpTimers[prefix] = setInterval(tick, 1000);
            }
            function resendOTP(prefix){
              if(prefix === 'reg'){
                sendRegOTP();
                return;
              }
              clearInterval(otpTimers[prefix]);
              document.querySelectorAll(`#${prefix}-otp-wrap .otp-input`).forEach(i=>{ i.value=''; i.classList.remove('filled'); });
              document.getElementById(`${prefix}-verify-btn`).disabled = true;
              startTimer(prefix);
              showToast('📱 Đã gửi lại mã OTP');
            }

            // ── TAB SWITCH ───────────────────────────────────────────────────
            function switchTab(tab){
              document.getElementById('tab-login').classList.toggle('active', tab==='login');
              document.getElementById('tab-register').classList.toggle('active', tab==='register');
              document.getElementById('section-login').classList.toggle('active', tab==='login');
              document.getElementById('section-register').classList.toggle('active', tab==='register');
            }

            // ── LOGIN FLOW ───────────────────────────────────────────────────
            function sendLoginOTP(){
              const phone = document.getElementById('login-phone').value.trim();
              if(!validatePhone(phone)){
                document.getElementById('login-phone-err').classList.add('show');
                return;
              }
              document.getElementById('login-phone-err').classList.remove('show');
              document.getElementById('login-phone-display').textContent = phone;
              hide('login-step1'); show('login-step2');
              startTimer('login');
              document.querySelector('#login-otp-wrap .otp-input').focus();
              showToast('📱 Mã OTP đã gửi về ' + phone);
            }
            function verifyLoginOTP(){
              const otp = getOTPValue('login');
              // Demo: OTP hợp lệ = "123456"
              if(otp === '123456' || otp.length === 6){
                clearInterval(otpTimers['login']);
                hide('login-step2'); show('login-step3');
              } else {
                showToast('❌ Mã OTP không đúng. Thử lại!');
              }
            }
            function loginWithPassword(){
              const phone = document.getElementById('login-phone').value.trim();
              const pw = document.getElementById('login-password').value;
              if(!phone || !pw){ showToast('Vui lòng nhập đầy đủ thông tin'); return; }
              hide('login-step1'); show('login-step3');
            }
            function backToPhone(prefix){
              clearInterval(otpTimers[prefix]);
              if(prefix==='login'){ hide('login-step2'); show('login-step1'); }
              else { hide('reg-step2'); show('reg-step1'); }
            }

            // ── REGISTER FLOW ────────────────────────────────────────────────
            let registerOtpVerified = false;
            function setRegStep(n){
              [1,2,3].forEach(i=>{
                const s = document.getElementById(`reg-s${i}`);
                const l = document.getElementById(`reg-s${i}-lbl`);
                if(!s) return;
                s.className = 'step-circle ' + (i<n?'done':i===n?'active':'pending');
                if(l) l.className = 'step-label' + (i===n?' active':'');
              });
              [1,2].forEach(i=>{
                const line = document.getElementById(`reg-line${i}`);
                if(line) line.className = 'step-line' + (i<n?' done':'');
              });
            }
            async function sendRegOTP(){
              const name = document.getElementById('reg-name').value.trim();
              const phone = document.getElementById('reg-phone').value.trim();
              let valid = true;
              if(!name){ document.getElementById('reg-name-err').classList.add('show'); valid=false; }
              else document.getElementById('reg-name-err').classList.remove('show');
              if(!validatePhone(phone)){ document.getElementById('reg-phone-err').classList.add('show'); valid=false; }
              else document.getElementById('reg-phone-err').classList.remove('show');
              if(!valid) return;
              try{
                const res = await fetch('@Url.Action("SendRegisterOtp", "Account")', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ phone })
                });
                const data = await res.json();
                if(!data.success){
                  showToast('❌ ' + (data.message || 'Gửi OTP thất bại'));
                  return;
                }
                registerOtpVerified = false;
                document.getElementById('register-otp-hidden').value = '';
                document.getElementById('reg-phone-display').textContent = phone;
                hide('reg-step1'); show('reg-step2');
                setRegStep(2);
                startTimer('reg');
                document.querySelector('#reg-otp-wrap .otp-input').focus();
                showToast('📱 ' + data.message);
              }catch{
                showToast('❌ Không thể kết nối máy chủ để gửi OTP');
              }
            }
            async function verifyRegOTP(){
              const otp = getOTPValue('reg');
              const phone = document.getElementById('reg-phone').value.trim();
              if(otp.length !== 6){
                showToast('❌ Vui lòng nhập đủ 6 số OTP');
                return;
              }
              try{
                const res = await fetch('@Url.Action("VerifyRegisterOtp", "Account")', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ phone, code: otp })
                });
                const data = await res.json();
                if(!data.success){
                  showToast('❌ ' + (data.message || 'OTP không hợp lệ'));
                  return;
                }
                registerOtpVerified = true;
                document.getElementById('register-otp-hidden').value = otp;
                clearInterval(otpTimers['reg']);
                hide('reg-step2'); show('reg-step3');
                setRegStep(3);
                showToast('✅ OTP hợp lệ');
              }catch{
                showToast('❌ Không thể xác thực OTP lúc này');
              }
            }
            function checkPwStrength(pw){
              const bars = [1,2,3,4].map(i=>document.getElementById(`pw-bar-${i}`));
              const label = document.getElementById('pw-label');
              bars.forEach(b=>b.className='pw-bar');
              if(!pw.length){ label.textContent='Nhập mật khẩu'; return; }
              let score = 0;
              if(pw.length>=8) score++;
              if(/[A-Z]/.test(pw)) score++;
              if(/\d/.test(pw)) score++;
              if(/[^A-Za-z0-9]/.test(pw)) score++;
              const cls = score<=1?'weak':score<=2?'medium':'strong';
              const labels = {weak:'Yếu',medium:'Trung bình',strong:'Mạnh'};
              bars.slice(0,score).forEach(b=>b.classList.add(cls));
              label.textContent = labels[cls] || '';
              label.style.color = cls==='weak'?'#E74C3C':cls==='medium'?'#B8860B':'#27AE60';
            }
            function completeRegister(){
              const name = document.getElementById('reg-name').value.trim();
              const phone = document.getElementById('reg-phone').value.trim();
              const pw = document.getElementById('reg-pw').value;
              const pw2 = document.getElementById('reg-pw2').value;
              if(!name || !validatePhone(phone)){
                showToast('Vui lòng nhập đúng họ tên và số điện thoại');
                return;
              }
              if(pw.length < 8){ showToast('Mật khẩu phải có ít nhất 8 ký tự'); return; }
              if(pw !== pw2){
                document.getElementById('pw-match-err').classList.add('show');
                document.getElementById('reg-pw2').classList.add('error');
                return;
              }
              if(!registerOtpVerified){
                showToast('Vui lòng xác thực OTP trước khi đăng ký');
                return;
              }
              document.getElementById('pw-match-err').classList.remove('show');
              document.getElementById('register-name-hidden').value = name;
              document.getElementById('register-phone-hidden').value = phone;
              document.getElementById('register-password-hidden').value = pw;
              document.getElementById('registerForm').submit();
              }
        </script>
</body>
</html>