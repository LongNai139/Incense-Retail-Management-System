@model SV22T1080045.Shop.DomainModels.Customers
@{
    ViewBag.Title = "Hồ sơ cá nhân";
}

@section Styles {
    <style>
        .profile-wrapper {
            max-width: 1000px; 
            margin: 0 auto;
        }

        .page-container {
            background: linear-gradient(135deg, #fff5fa 0%, #f3e7fb 100%);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .profile-box {
            background: #fff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(173, 143, 222, 0.1);
            height: 100%; 
            transition: transform 0.2s;
        }

            .profile-box:hover {
                transform: translateY(-2px);
            }

        .title-section {
            font-weight: 700;
            font-size: 18px;
            color: #C75EBE;
            margin-bottom: 20px;
            border-bottom: 2px solid #fce3f0;
            padding-bottom: 10px;
            display: flex;
            align-items: center;
        }

        .form-label {
            font-weight: 600;
            color: #555;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 10px 15px;
            font-size: 0.95rem;
        }

            .form-control:focus {
                border-color: #C75EBE;
                box-shadow: 0 0 0 0.2rem rgba(199, 94, 190, 0.25);
            }

        .btn-primary-custom {
            background-color: #C75EBE;
            border: none;
            border-radius: 8px;
            color: white;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.3s;
            width: 100%;
        }

            .btn-primary-custom:hover {
                background-color: #a54b9d;
                transform: translateY(-2px);
            }

        .btn-warning-custom {
            background-color: #ffb74d;
            border: none;
            border-radius: 8px;
            color: white;
            padding: 10px 20px;
            font-weight: 600;
        }

        /* Avatar style */
        .avatar-container {
            width: 100px;
            height: 100px;
            margin: 0 auto 15px;
            position: relative;
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
    </style>
}

<div class="profile-wrapper my-4">
    <div class="page-container">
        <div class="row gy-4">

            <div class="col-lg-4">
                <div class="profile-box">
                    <div class="text-center mb-4">
                        <div class="avatar-container">
                            <img src="~/images/doraemon-logo.png" onerror="this.src='https://placehold.co/100x100?text=User'" class="avatar-img" alt="Avatar" />
                            <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2" title="Online"></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@Model.CustomerName</h5>
                        <p class="text-muted small">Thành viên thân thiết</p>
                    </div>

                    <div class="title-section"><i class="bi bi-person-badge me-2"></i>Cá nhân</div>

                    <form action="/Account/UpdateProfile" method="post">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="text" class="form-control bg-light text-muted" value="@Model.Email" readonly disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" name="CustomerName" class="form-control" value="@Model.CustomerName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="text" name="Phone" class="form-control" value="@Model.Phone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <textarea name="Address" class="form-control" rows="3" style="resize: none;">@Model.Address</textarea>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary-custom">
                                <i class="bi bi-save me-2"></i>Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="d-flex flex-column gap-4 h-100">

                    <div class="profile-box">
                        <div class="title-section"><i class="bi bi-shield-lock me-2"></i>Bảo mật tài khoản</div>

                        @if (TempData["PassSuccess"] != null)
                        {
                            <div class="alert alert-success py-2 small rounded-3"><i class="bi bi-check-circle me-2"></i>@TempData["PassSuccess"]</div>
                        }
                        @if (TempData["PassError"] != null)
                        {
                            <div class="alert alert-danger py-2 small rounded-3"><i class="bi bi-exclamation-circle me-2"></i>@TempData["PassError"]</div>
                        }

                        <form action="/Account/ChangePassword" method="post">
                            <div class="mb-3">
                                <label class="form-label">Mật khẩu hiện tại</label>
                                <input type="password" name="oldPass" class="form-control" required />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mật khẩu mới</label>
                                    <input type="password" name="newPass" class="form-control" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Xác nhận mật khẩu mới</label>
                                    <input type="password" name="confirmPass" class="form-control" required />
                                </div>
                            </div>
                            <div class="text-end mt-2">
                                <button class="btn btn-warning-custom">
                                    <i class="bi bi-key me-2"></i>Cập nhật mật khẩu
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="profile-box" style="flex: 1;">
                        <div class="title-section text-dark"><i class="bi bi-grid-fill me-2"></i>Tiện ích</div>

                        <div class="row g-3 align-items-center mb-3">
                            <div class="col-8">
                                <div class="fw-bold">Lịch sử mua hàng</div>
                                <small class="text-muted">Xem lại trạng thái đơn hàng đã đặt</small>
                            </div>
                            <div class="col-4 text-end">
                                <a href="/Order/History" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Xem ngay <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25">

                        <div class="row g-3 align-items-center">
                            <div class="col-8">
                                <div class="fw-bold text-danger">Đăng xuất</div>
                                <small class="text-muted">Thoát khỏi phiên làm việc</small>
                            </div>
                            <div class="col-4 text-end">
                                <a href="/Account/Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    Đăng xuất
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>