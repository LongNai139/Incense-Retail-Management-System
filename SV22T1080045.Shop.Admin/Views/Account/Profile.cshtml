@model SV22T1080045.Shop.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}


<div class="profile-page-wrapper">
    <div class="profile-grid-container">

        <!-- SIDEBAR TRÁI -->
        <aside class="profile-sidebar">
            <div class="profile-sidebar-card">
                <div class="profile-head-info">
                    <div class="avatar-circle-custom">
                        @((Model.CustomerName.FirstOrDefault() == default(char) ? 'K' : Model.CustomerName.First()).ToString().ToUpper())
                    </div>
                    <h2 class="profile-name-txt">@Model.CustomerName</h2>
                    <p class="profile-phone-txt">@Model.Phone</p>
                    <span class="badge-member-tag">Thành viên thân thiết</span>
                </div>

                <div class="profile-stats-grid">
                    <div class="stat-box">
                        <span class="stat-num">@Model.TotalOrders</span>
                        <span class="stat-lbl">Tổng đơn</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-num">@Model.InTransitOrders</span>
                        <span class="stat-lbl">Đang giao</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-num">@Model.Points.ToString("N0")</span>
                        <span class="stat-lbl">Điểm</span>
                    </div>
                </div>

                <nav class="profile-menu-vertical">
                    <a asp-controller="Account" asp-action="Profile" class="menu-link-item active-link">
                        <i class="fa-regular fa-user"></i>
                        <span>Thông tin tài khoản</span>
                    </a>
                    <a asp-controller="MyOrders" asp-action="Index" class="menu-link-item">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>Lịch sử đơn hàng</span>
                    </a>
                    <a asp-controller="OrderLookup" asp-action="Index" class="menu-link-item">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Tra cứu đơn hàng</span>
                    </a>
                    <a asp-controller="Account" asp-action="ChangePassword" class="menu-link-item">
                        <i class="fa-solid fa-key"></i>
                        <span>Đổi mật khẩu</span>
                    </a>
                    <div class="menu-divider-line"></div>
                    <a asp-controller="Account" asp-action="Logout" class="menu-link-item logout-link">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- FORM PHẢI -->
        <main class="profile-main">
            <div class="profile-main-card">
                <div class="form-head-title">
                    <h1 class="title-txt">Thông tin cá nhân</h1>
                    <p class="subtitle-txt">Quản lý thông tin tài khoản và địa chỉ giao hàng mặc định.</p>
                </div>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert-success-msg">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>@TempData["ProfileSuccess"]</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Profile" method="post" class="profile-form-body">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="error-summary-msg"></div>

                    <div class="form-fields-grid">
                        <div class="form-group-item">
                            <label asp-for="CustomerName" class="form-label-txt">Họ và tên <span class="req-mark">*</span></label>
                            <input asp-for="CustomerName" class="form-input-ctrl" placeholder="Nhập họ và tên..." />
                            <span asp-validation-for="CustomerName" class="form-field-err"></span>
                        </div>

                        <div class="form-group-item">
                            <label asp-for="Phone" class="form-label-txt">Số điện thoại</label>
                            <input asp-for="Phone" class="form-input-ctrl disabled-input" readonly tabindex="-1" />
                            <small class="form-hint-txt">Số điện thoại dùng làm tài khoản (Không thể sửa)</small>
                        </div>

                        <div class="form-group-item full-col">
                            <label asp-for="Email" class="form-label-txt">Địa chỉ Email</label>
                            <input asp-for="Email" class="form-input-ctrl" placeholder="example@gmail.com" />
                            <span asp-validation-for="Email" class="form-field-err"></span>
                        </div>

                        <div class="form-group-item full-col">
                            <label asp-for="Address" class="form-label-txt">Địa chỉ giao hàng mặc định</label>
                            <textarea asp-for="Address" class="form-textarea-ctrl" rows="3" placeholder="Nhập địa chỉ nhận hàng cố định..."></textarea>
                            <span asp-validation-for="Address" class="form-field-err"></span>
                        </div>
                    </div>

                    <div class="form-actions-footer">
                        <a asp-controller="Home" asp-action="Index" class="btn-back-link">Trở về trang chủ</a>
                        <button type="submit" class="btn-submit-main">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </main>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}