@{
    Layout = "_ManagementLayout";
}

@model SV22T1080045.Shop.Controllers.StockTransactionViewModel
@using System.Globalization
@using SV22T1080045.Shop.DomainModels.Warehouse

@{
    ViewData["Title"] = "Giao dịch kho";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    string TransactionTypeText(string type) => type switch
    {
        "Import" => "Nhập kho",
        "Export" => "Xuất kho",
        "Restock" => "Tái nhập",
        "Return" => "Trả hàng",
        "Adjustment" => "Điều chỉnh",
        _ => type
    };
}

<section class="management-hero">
    <div>
        <div class="management-kicker">Precious Wood</div>
        <h1>Giao dịch kho</h1>
        <p>Theo dõi các giao dịch nhập/xuất kho, tái nhập và điều chỉnh tồn kho.</p>
    </div>
    <div class="management-actions">
        <a class="admin-btn primary" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Về tổng quan</a>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div>
            <h2>Lịch sử giao dịch kho</h2>
            <p class="admin-section-desc">Xem và quản lý tất cả các giao dịch kho.</p>
        </div>
        <form class="time-filter-row" asp-action="StockTransactions" method="get">
            <select class="admin-select" name="productId" style="width: 200px;">
                <option value="">Tất cả sản phẩm</option>
                @foreach (var product in Model.AvailableProducts)
                {
                    <option value="@product.Value" selected="@(Model.ProductId.ToString() == product.Value ? "selected" : null)">@product.Text</option>
                }
            </select>
            <input class="admin-input" type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
            <input class="admin-input" type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
            <button class="admin-btn" type="submit"><i class="fa-solid fa-filter"></i> Lọc</button>
        </form>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Sản phẩm</th>
                    <th>Loại giao dịch</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Tổng tiền</th>
                    <th>Ngày giao dịch</th>
                    <th>Người tạo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions.Any())
                {
                    foreach (var transaction in Model.Transactions)
                    {
                        <tr>
                            <td>@transaction.Id</td>
                            <td>@(string.IsNullOrEmpty(transaction.ProductName) ? "ID: " + transaction.ProductId : transaction.ProductName)</td>
                            <td><span class="status-badge status-ready">@TransactionTypeText(transaction.TransactionType)</span></td>
                            <td>@transaction.Quantity</td>
                            <td>@FormatMoney(transaction.UnitPrice)</td>
                            <td>@FormatMoney(transaction.TotalAmount)</td>
                            <td>@transaction.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@transaction.CreatedBy?.ToString() ?? "System"</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8">Chưa có giao dịch kho nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div>
            <h2>Thêm giao dịch kho mới</h2>
            <p class="admin-section-desc">Nhập thông tin giao dịch kho mới.</p>
        </div>
    </div>

    <form asp-action="AddStockTransaction" method="post" class="form-grid">
        <div class="field">
            <label>Sản phẩm</label>
            <select class="admin-select" name="ProductId" required>
                <option value="">Chọn sản phẩm</option>
                @foreach (var product in Model.AvailableProducts)
                {
                    <option value="@product.Value">@product.Text</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Loại giao dịch</label>
            <select class="admin-select" name="TransactionType">
                <option value="Import">Nhập kho</option>
                <option value="Export">Xuất kho</option>
                <option value="Restock">Tái nhập</option>
                <option value="Return">Trả hàng</option>
                <option value="Adjustment">Điều chỉnh</option>
            </select>
        </div>
        <div class="field">
            <label>Số lượng</label>
            <input class="admin-input" name="Quantity" type="number" required />
        </div>
        <div class="field">
            <label>Đơn giá</label>
            <input class="admin-input" name="UnitPrice" type="number" step="0.01" required />
        </div>
        <div class="field">
            <label>Mã tham chiếu</label>
            <input class="admin-input" name="ReferenceNumber" placeholder="Mã đơn hàng, hóa đơn..." />
        </div>
        <div class="field">
            <label>Lý do</label>
            <input class="admin-input" name="Reason" placeholder="Lý do giao dịch..." />
        </div>
        <div class="field">
            <label>Ngày giao dịch</label>
            <input class="admin-input" name="TransactionDate" type="date" />
        </div>
        <div class="field" style="display: flex; align-items: flex-end;">
            <button class="admin-btn primary" type="submit"><i class="fa-solid fa-plus"></i> Thêm giao dịch</button>
        </div>
    </form>
</section>