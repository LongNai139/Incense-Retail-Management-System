@{
    Layout = "_ManagementLayout";
}

@model SV22T1080045.Shop.Models.ViewModels.Warehouse.CustomerDebtPageViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Công nợ khách hàng";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
    string StatusText(string status) => status switch
    {
        "Pending" => "Chưa thanh toán",
        "PartiallyPaid" => "Thanh toán một phần",
        "Paid" => "Đã thanh toán",
        "Overdue" => "Quá hạn",
        _ => status
    };
    string StatusClass(string status) => status switch
    {
        "Pending" => "status-pending",
        "PartiallyPaid" => "status-ready",
        "Paid" => "status-done",
        "Overdue" => "status-cancel",
        _ => "status-ready"
    };
    string TransactionTypeText(string type) => type switch
    {
        "DEBIT" => "Tăng nợ",
        "CREDIT" => "Giảm nợ",
        _ => type
    };
    string TransactionTypeClass(string type) => type switch
    {
        "DEBIT" => "text-danger",
        "CREDIT" => "text-success",
        _ => ""
    };
}

<section class="management-hero">
    <div>
        <div class="management-kicker">Precious Wood</div>
        <h1>Công nợ khách hàng</h1>
        <p>Quản lý công nợ khách hàng và theo dõi thanh toán.</p>
    </div>
    <div class="management-actions">
        <a class="admin-btn primary" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Về tổng quan</a>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div>
            <h2>Danh sách công nợ</h2>
            <p class="admin-section-desc">Theo dõi và quản lý công nợ của khách hàng.</p>
        </div>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Khách hàng</th>
                    <th>Mã đơn hàng</th>
                    <th>Số nợ</th>
                    <th>Đã thanh toán</th>
                    <th>Còn lại</th>
                    <th>Hạn thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Debts.Any())
                {
                    foreach (var debt in Model.Debts)
                    {
                        var paymentReference = $"PAYUI-{Guid.NewGuid():N}";
                        <tr>
                            <td>@debt.Id</td>
                            <td>Khách ID: @debt.CustomerId</td>
                            <td>@debt.OrderCode</td>
                            <td>@FormatMoney(debt.DebtAmount)</td>
                            <td>@FormatMoney(debt.PaidAmount)</td>
                            <td><strong>@FormatMoney(debt.RemainingAmount)</strong></td>
                            <td>@debt.DueDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="status-badge @StatusClass(debt.Status)">@StatusText(debt.Status)</span></td>
                            <td>
                                @if (debt.RemainingAmount > 0)
                                {
                                    <button class="admin-btn primary" type="button" data-pay-debt data-debt-id="@debt.Id" data-payment-reference="@paymentReference" style="padding: 4px 8px; font-size: 11px;">
                                        <i class="fa-solid fa-money-bill"></i> Thanh toán
                                    </button>
                                    @Html.AntiForgeryToken()
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9">Chưa có công nợ nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div>
            <h2>Thêm công nợ mới</h2>
            <p class="admin-section-desc">Tạo công nợ mới cho khách hàng.</p>
        </div>
    </div>

    <form asp-action="AddCustomerDebt" method="post" class="form-grid">
        <div class="field">
            <label>Khách hàng</label>
            <input class="admin-input" name="CustomerId" type="number" required />
        </div>
        <div class="field">
            <label>Mã đơn hàng</label>
            <input class="admin-input" name="OrderCode" placeholder="#TH000001" />
        </div>
        <div class="field">
            <label>Số tiền nợ</label>
            <input class="admin-input" name="DebtAmount" type="number" step="0.01" required />
        </div>
        <div class="field">
            <label>Số tiền thanh toán</label>
            <input class="admin-input" name="PaidAmount" type="number" step="0.01" value="0" />
        </div>
        <div class="field">
            <label>Hạn thanh toán</label>
            <input class="admin-input" name="DueDate" type="date" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label>Mã tham chiếu</label>
            <input class="admin-input" name="PaymentReference" placeholder="Mã thanh toán..." />
        </div>
        <div class="field">
            <label>Ghi chú</label>
            <input class="admin-input" name="Notes" placeholder="Ghi chú..." />
        </div>
        <div class="field" style="display: flex; align-items: flex-end;">
            <button class="admin-btn primary" type="submit"><i class="fa-solid fa-plus"></i> Thêm công nợ</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener('click', function (event) {
            var payBtn = event.target.closest('[data-pay-debt]');
            if (!payBtn) return;

            event.preventDefault();
            var debtId = payBtn.getAttribute('data-debt-id');
            var paymentReference = payBtn.getAttribute('data-payment-reference');
            var token = payBtn.parentElement.querySelector('input[name="__RequestVerificationToken"]');
            var amount = prompt('Nhập số tiền thanh toán:');
            
            if (amount && !isNaN(amount) && Number(amount) > 0) {
                var formData = new FormData();
                formData.append('debtId', debtId);
                formData.append('paymentAmount', amount);
                formData.append('paymentReference', paymentReference);
                if (token) formData.append('__RequestVerificationToken', token.value);
                
                fetch('/Warehouse/ProcessPayment', {
                    method: 'POST',
                    body: formData
                })
                .then(function (response) {
                    if (response.ok) {
                        return response.text();
                    }
                    throw new Error('Không thể xử lý thanh toán.');
                })
                .then(function () {
                    alert('Đã xử lý thanh toán thành công.');
                    location.reload();
                })
                .catch(function () {
                    alert('Không thể xử lý thanh toán. Vui lòng thử lại.');
                });
            } else if (amount !== null) {
                alert('Vui lòng nhập số tiền hợp lệ lớn hơn 0.');
            }
        });
    </script>
}
