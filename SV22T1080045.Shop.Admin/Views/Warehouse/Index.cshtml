@{
    Layout = "_ManagementLayout";
}

@model SV22T1080045.Shop.Controllers.WarehouseDashboardViewModel
@using System.Globalization
@using SV22T1080045.Shop.DomainModels.Warehouse

@{
    ViewData["Title"] = "Quản lý kho";

    string FormatMoney(decimal value) => value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + "đ";
}

<section class="management-hero">
    <div>
        <div class="management-kicker">Precious Wood</div>
        <h1>Quản lý kho</h1>
        <p>Quản lý tồn kho, giao dịch kho và công nợ khách hàng.</p>
    </div>
    <div class="management-actions">
        <a class="admin-btn primary" asp-action="StockTransactions"><i class="fa-solid fa-exchange-alt"></i> Giao dịch kho</a>
        <a class="admin-btn" asp-action="CustomerDebts"><i class="fa-solid fa-file-invoice-dollar"></i> Công nợ</a>
    </div>
</section>

<section class="admin-section">
    <div class="admin-section-head">
        <div>
            <h2>Tổng quan kho</h2>
            <p class="admin-section-desc">Tình trạng tồn kho và công nợ khách hàng.</p>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon stock"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div class="kpi-label">Sản phẩm sắp hết</div>
            <div class="kpi-value">@Model.LowStockCount</div>
            <div class="kpi-note">sản phẩm cần nhập kho</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon orders"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="kpi-label">Hết hàng</div>
            <div class="kpi-value">@Model.OutOfStockCount</div>
            <div class="kpi-note">sản phẩm hết tồn kho</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon revenue"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div class="kpi-label">Tổng công nợ</div>
            <div class="kpi-value">@FormatMoney(Model.TotalDebt)</div>
            <div class="kpi-note">@Model.OverdueDebtCount công nợ quá hạn</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon customers"><i class="fa-solid fa-users"></i></div>
            <div class="kpi-label">Tồn kho tổng</div>
            <div class="kpi-value">@Model.StockInventories.Sum(i => i.CurrentQuantity)</div>
            <div class="kpi-note">sản phẩm trong kho</div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="admin-panel">
            <div class="panel-title">Tồn kho thấp</div>
            <div class="warning-list">
                @if (Model.StockInventories.Where(i => i.IsLowStock).Any())
                {
                    foreach (var item in Model.StockInventories.Where(i => i.IsLowStock).Take(5))
                    {
                        <div class="warning-item">
                            <div>
                                <div class="item-name">@(string.IsNullOrEmpty(item.ProductName) ? "Sản phẩm ID: " + item.ProductId : item.ProductName)</div>
                                <div class="item-meta">Ngưỡng: @item.LowStockThreshold</div>
                            </div>
                            <div class="warning-count">@item.CurrentQuantity</div>
                        </div>
                    }
                }
                else
                {
                    <div class="item-meta">Không có sản phẩm nào sắp hết hàng.</div>
                }
            </div>
        </div>

        <div class="admin-panel">
            <div class="panel-title">Công nợ quá hạn</div>
            <div class="warning-list">
                @if (Model.CustomerDebts.Where(d => d.IsOverdue).Any())
                {
                    foreach (var debt in Model.CustomerDebts.Where(d => d.IsOverdue).Take(5))
                    {
                        <div class="warning-item">
                            <div>
                                <div class="item-name">@(string.IsNullOrEmpty(debt.CustomerName) ? "Khách hàng ID: " + debt.CustomerId : debt.CustomerName)</div>
                                <div class="item-meta">Quá hạn: @debt.DueDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="warning-count">@FormatMoney(debt.RemainingAmount)</div>
                        </div>
                    }
                }
                else
                {
                    <div class="item-meta">Không có công nợ quá hạn.</div>
                }
            </div>
        </div>
    </div>
</section>